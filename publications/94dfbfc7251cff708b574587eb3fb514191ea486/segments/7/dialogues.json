[
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 0,
    "text": "The Fairy Flower",
    "speed": 1.0,
    "audio_description": "",
    "trailing_silence_s": 1.0,
    "start_s": 0.0,
    "end_s": 2.04,
    "duration_s": 2.04,
    "title": true
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 1,
    "text": "And she held the little Rabbit close in her arms and flew with him into the wood.",
    "speed": 1.0,
    "audio_description": "narrating",
    "trailing_silence_s": 0.5,
    "start_s": 2.04,
    "end_s": 6.807347,
    "duration_s": 4.767347
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 2,
    "text": "It was light now, for the moon had risen. All the forest was beautiful, and the fronds of the bracken shone like frosted silver.",
    "speed": 1.0,
    "audio_description": "narrating, atmospheric",
    "trailing_silence_s": 0.5,
    "start_s": 6.807347,
    "end_s": 14.63102,
    "duration_s": 7.823673
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 3,
    "text": "In the open glade between the tree-trunks the wild rabbits danced with their shadows on the velvet grass, but when they saw the Fairy they all stopped dancing and stood round in a ring to stare at her.",
    "speed": 1.0,
    "audio_description": "narrating",
    "trailing_silence_s": 0.5,
    "start_s": 14.63102,
    "end_s": 26.608162999999998,
    "duration_s": 11.977143
  },
  {
    "character_identifier": "NURSERY_MAGIC_FAIRY",
    "scene_identifier": "SCENE_03",
    "ordinal": 4,
    "text": "I've brought you a new playfellow,",
    "speed": 1.0,
    "audio_description": "warm, announcing",
    "trailing_silence_s": 0.2,
    "start_s": 26.608162999999998,
    "end_s": 28.345305999999997,
    "duration_s": 1.737143
  },
  {
    "character_identifier": "NURSERY_MAGIC_FAIRY",
    "scene_identifier": "SCENE_03",
    "ordinal": 5,
    "text": "You must be very kind to him and teach him all he needs to know in Rabbit-land, for he is going to live with you for ever and ever!",
    "speed": 1.0,
    "audio_description": "gentle, instructing",
    "trailing_silence_s": 0.5,
    "start_s": 28.345305999999997,
    "end_s": 36.631972999999995,
    "duration_s": 8.286667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 6,
    "text": "And she kissed the little Rabbit again and put him down on the grass.",
    "speed": 1.0,
    "audio_description": "narrating",
    "trailing_silence_s": 0.5,
    "start_s": 36.631972999999995,
    "end_s": 41.13809499999999,
    "duration_s": 4.506122
  },
  {
    "character_identifier": "NURSERY_MAGIC_FAIRY",
    "scene_identifier": "SCENE_03",
    "ordinal": 7,
    "text": "Run and play, little Rabbit!",
    "speed": 1.0,
    "audio_description": "encouraging, happy",
    "trailing_silence_s": 0.5,
    "start_s": 41.13809499999999,
    "end_s": 43.30476199999999,
    "duration_s": 2.166667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 8,
    "text": "But the little Rabbit sat quite still for a moment and never moved. For when he saw all the wild rabbits dancing around him he suddenly remembered about his hind legs, and he didn't want them to see that he was made all in one piece.",
    "speed": 1.0,
    "audio_description": "narrating, sympathetic",
    "trailing_silence_s": 0.5,
    "start_s": 43.30476199999999,
    "end_s": 58.10312899999999,
    "duration_s": 14.798367
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 9,
    "text": "He did not know that when the Fairy kissed him that last time she had changed him altogether. And he might have sat there a long time, too shy to move, if just then something hadn't tickled his nose, and before he thought what he was doing he lifted his hind toe to scratch it.",
    "speed": 1.0,
    "audio_description": "narrating",
    "trailing_silence_s": 0.5,
    "start_s": 58.10312899999999,
    "end_s": 73.84190499999998,
    "duration_s": 15.738776
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 10,
    "text": "And he found that he actually had hind legs! Instead of dingy velveteen he had brown fur, soft and shiny, his ears twitched by themselves, and his whiskers were so long that they brushed the grass.",
    "speed": 1.0,
    "audio_description": "narrating, amazed",
    "trailing_silence_s": 0.5,
    "start_s": 73.84190499999998,
    "end_s": 87.38190499999999,
    "duration_s": 13.54
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 11,
    "text": "He gave one leap and the joy of using those hind legs was so great that he went springing about the turf on them, jumping sideways and whirling round as the others did, and he grew so excited that when at last he did stop to look for the Fairy she had gone.",
    "speed": 1.0,
    "audio_description": "narrating, joyful",
    "trailing_silence_s": 0.5,
    "start_s": 87.38190499999999,
    "end_s": 102.25863999999999,
    "duration_s": 14.876735
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_03",
    "ordinal": 12,
    "text": "He was a Real Rabbit at last, at home with the other rabbits.",
    "speed": 1.0,
    "audio_description": "narrating, heartwarming",
    "trailing_silence_s": 1.0,
    "start_s": 102.25863999999999,
    "end_s": 106.68639499999999,
    "duration_s": 4.427755
  }
]