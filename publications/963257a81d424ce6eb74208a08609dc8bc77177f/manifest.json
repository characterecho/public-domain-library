    {
      "identifier": "SCENE_CENTRAL_STATION",
      "ordinal": 0,
      "location_header": "EXT. CENTRAL STATION - NIGHT",
      "visual_description": "A chaotic colonial station on a riverbank at night. Moonlight illuminates a clay hut with a grass roof and the muddy slope down to the river. The wreck of a steamboat lies nearby. Deep shadows and a conspiratorial, eerie atmosphere.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_CENTRAL_STATION.jpg"
    },
    {
      "identifier": "SCENE_INNER_STATION",
      "ordinal": 0,
      "location_header": "EXT. INNER STATION - DAY",
      "visual_description": "A clearing on a hill slope with rare trees. A decaying building stands on the summit with gaping holes in the roof. Ornamental posts topped with round balls line the path. The jungle forms a dark background. Bright sunshine illuminates the ruin.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_INNER_STATION.jpg"
    },
    {
      "identifier": "SCENE_RIVER_JOURNEY",
      "ordinal": 1,
      "location_header": "EXT. RIVER CONGO - DAY",
      "visual_description": "A steamboat crawling up a massive African river. Towering walls of dense green forest line the banks, dwarfing the tiny boat. The water is muddy and treacherous. Intense tropical sunlight beats down, creating high contrast and deep gloom within the trees.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_RIVER_JOURNEY.jpg"
    },
    {
      "identifier": "SCENE_STEAMER_CABIN",
      "ordinal": 1,
      "location_header": "INT. STEAMER CABIN - NIGHT",
      "visual_description": "A cramped, dimly lit cabin on a river steamboat. A camp bed cluttered with torn envelopes and open letters dominates the space. A candle casts flickering shadows on rough wooden walls. The atmosphere is stifling, intimate, and shadowed by death.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_STEAMER_CABIN.jpg"
    },
    {
      "identifier": "SCENE_COMPANY_OFFICES",
      "ordinal": 1,
      "location_header": "INT. COMPANY OFFICES - DAY",
      "visual_description": "A dimly lit waiting room with a deal table and a large map of Africa, a sanctuary-like inner office with a heavy writing desk and heavy curtains. The atmosphere is ominous, bureaucratic, and slightly surreal.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_COMPANY_OFFICES.jpg"
    },
    {
      "identifier": "SCENE_COASTAL_VOYAGE",
      "ordinal": 2,
      "location_header": "EXT. STEAMER DECK - DAY",
      "visual_description": "The deck of a French steamer under a fierce tropical sun. The view looks out towards a monotonous, dark-green jungle coastline fringed with white surf. The sea is oily and languid. The mood is isolated, mournful, and hot.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_COASTAL_VOYAGE.jpg"
    },
    {
      "identifier": "SCENE_SEPULCHRAL_CITY",
      "ordinal": 2,
      "location_header": "EXT. BRUSSELS - DAY",
      "visual_description": "A grey, imposing European city street lined with tall, severe houses. The light is flat and colorless, reflecting off damp pavement. Interiors are bureaucratic and dimly lit. A cold, orderly, and lifeless atmosphere prevails.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_SEPULCHRAL_CITY.jpg"
    },
    {
      "identifier": "SCENE_OUTER_STATION",
      "ordinal": 3,
      "location_header": "EXT. OUTER STATION - DAY",
      "visual_description": "A chaotic colonial station on a rocky riverbank. Rusty rails and decaying machinery lie in the grass. A grove of gloomy trees provides shade for exhausted figures. A ramshackle building stands on the slope. Blinding sunlight contrasts with deep, dark shadows.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_OUTER_STATION.jpg"
    },
    {
      "identifier": "SCENE_INTENDED_DRAWING_ROOM",
      "ordinal": 3,
      "location_header": "INT. DRAWING ROOM - DUSK",
      "visual_description": "A lofty Victorian drawing room at dusk. Three floor-to-ceiling windows resemble luminous columns against the gathering dark. Massive mahogany furniture with gilt accents gleams faintly. A grand piano stands like a polished sarcophagus. The mood is funereal and hushed.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_INTENDED_DRAWING_ROOM.jpg"
    },
    {
      "identifier": "SCENE_RIVER_FOG",
      "ordinal": 3,
      "location_header": "EXT. RIVER CONGO - FOG",
      "visual_description": "A blinding white fog on the river, warm and clammy. It surrounds the steamboat like a solid wall, obscuring everything beyond a few feet of water. The lighting is diffused, opaque, and shadowless, creating a sense of isolation and blindness.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_RIVER_FOG.jpg"
    },
    {
      "identifier": "SCENE_RIVER_ATTACK",
      "ordinal": 4,
      "location_header": "EXT. RIVER CONGO - DAY",
      "visual_description": "A narrow river channel heavily overshadowed by overhanging trees and bushes. Smoke from gunfire drifts across the water. The pilot-house of the steamboat is visible, with arrows sticking to the wood. The atmosphere is chaotic and smoky.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_RIVER_ATTACK.jpg"
    },
    {
      "identifier": "SCENE_THE_NELLIE",
      "ordinal": 4,
      "location_header": "EXT. THE NELLIE - NIGHT",
      "visual_description": "Late 19th-century maritime setting at night. The deck of a cruising yawl on the Thames estuary. Dark water stretches to the horizon, merging with a brooding, gloomy sky. The only light comes from the glow of a pipe and the faint stars.",
      "metadata": {},
      "image_key": "publications/963257a81d424ce6eb74208a08609dc8bc77177f/scenes/scene_SCENE_THE_NELLIE.jpg"
    },
    {
      "identifier": "SCENE_THE_TREK",
