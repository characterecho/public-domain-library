          },
          {
            "identifier": "SCENE_STEAMER_CABIN",
            "location_header": "INT. STEAMER CABIN - NIGHT",
            "visual_description": "A cramped, dimly lit cabin on a river steamboat. A camp bed cluttered with torn envelopes and open letters dominates the space. A candle casts flickering shadows on rough wooden walls. The atmosphere is stifling, intimate, and shadowed by death."
          },
          {
            "identifier": "SCENE_SEPULCHRAL_CITY",
            "location_header": "EXT. BRUSSELS - DAY",
            "visual_description": "A grey, imposing European city street lined with tall, severe houses. The light is flat and colorless, reflecting off damp pavement. Interiors are bureaucratic and dimly lit. A cold, orderly, and lifeless atmosphere prevails."
          },
          {
            "identifier": "SCENE_INTENDED_DRAWING_ROOM",
            "location_header": "INT. DRAWING ROOM - DUSK",
            "visual_description": "A lofty Victorian drawing room at dusk. Three floor-to-ceiling windows resemble luminous columns against the gathering dark. Massive mahogany furniture with gilt accents gleams faintly. A grand piano stands like a polished sarcophagus. The mood is funereal and hushed."
          },
          {
            "identifier": "SCENE_THE_NELLIE",
            "location_header": "EXT. THE NELLIE - NIGHT",
            "visual_description": "Late 19th-century maritime setting at night. The deck of a cruising yawl on the Thames estuary. Dark water stretches to the horizon, merging with a brooding, gloomy sky. The only light comes from the glow of a pipe and the faint stars."
          }
        ]
      },
      "background_key": null
    }
