      "title": "V",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_TAPESTRY_CHAMBER",
            "location_header": "INT. TAPESTRY CHAMBER - LATE AFTERNOON",
            "visual_description": "A gloomy, neglected chamber in a Victorian manor bathed in the ruined gold light of autumn twilight. Faded green tapestries depicting huntsmen line the walls. A heavy carved chimneypiece features grotesque wooden animals. A tall window overlooks a long avenue of trees shedding yellow leaves. The atmosphere is dusty, melancholic, and shadowed."
          }
        ]
      },
      "background_key": null,
