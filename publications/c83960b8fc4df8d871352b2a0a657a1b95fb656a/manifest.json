    {
      "ordinal": 6,
      "title": "VI",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_EXT_DRIVE",
            "location_header": "EXT. COUNTRY ROAD - NIGHT",
            "visual_description": "A lush English countryside landscape at twilight transitioning into night. Pine woods and ferns line the road. Shadows lengthen across the path. The atmosphere is frantic and foreboding, lit by the last dregs of sunset and rising moonlight."
          },
          {
            "identifier": "SCENE_GREAT_HALL",
            "location_header": "INT. GREAT HALL - NIGHT",
            "visual_description": "A grand Victorian entrance hall and staircase at midnight. A large clock tower is visible or audible nearby. Heavy oak panelling, a dining room visible in the background with leftover supper. The space is dimly lit by gas lamps and a sudden flash of lightning. Mood is tense, shifting to supernatural awe."
          },
          {
            "identifier": "SCENE_SECRET_CHAMBER",
            "location_header": "INT. SECRET CHAMBER - NIGHT",
            "visual_description": "A cramped, dusty secret chamber inside a thick stone wall. A single beam of moonlight cuts through a narrow grated window, illuminating a gaunt skeleton chained to the wall. Rough-hewn stone walls encompass the space. The atmosphere is ancient, tragic, and solemn."
          }
        ]
      },
