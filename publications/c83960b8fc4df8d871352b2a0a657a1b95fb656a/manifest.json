    {
      "ordinal": 1,
      "title": "I",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_CANTERVILLE_STUDY",
            "location_header": "INT. LORD CANTERVILLE'S STUDY - DAY",
            "visual_description": "A late Victorian gentleman's private study. Dark mahogany bookshelves line the walls, filled with leather-bound volumes. Heavy velvet curtains partially block afternoon light. A large wooden desk with brass fittings sits in the foreground. The atmosphere is formal, serious, and aristocratic, with rich burgundy and brown tones."
          },
          {
            "identifier": "SCENE_EXT_DRIVE",
            "location_header": "EXT. COUNTRY ROAD - EVENING",
            "visual_description": "A lush English countryside landscape at sunset viewed from a moving carriage. Pine woods and ferns line the road. Golden hour light filtering through trees, transitioning into ominous grey clouds and shadows. A sense of movement through nature, turning from idyllic to slightly foreboding."
          },
          {
            "identifier": "SCENE_LIBRARY",
            "location_header": "INT. CANTERVILLE CHASE LIBRARY - EVENING",
            "visual_description": "A grand Tudor library with low ceilings and black oak paneling. A large stained glass window dominates the far wall. In the foreground, a dark wooden floor features a distinct dull red stain near a stone fireplace. The room is dimly lit, casting long shadows, with a somber and mysterious atmosphere."
          }
        ]
      },
      "background_key": null,
      "audio_key": "publications/c83960b8fc4df8d871352b2a0a657a1b95fb656a/segments/1/audio.mp3",
      "duration_s": 477.4476199999999
    },
    {
      "ordinal": 2,
      "title": "II",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_UPSTAIRS_CORRIDOR",
            "location_header": "INT. UPSTAIRS CORRIDOR - NIGHT",
            "visual_description": "A long Victorian corridor at night, bathed in wan moonlight filtering through tall windows. Dark oak wainscoting lines the walls below patterned wallpaper. A marble table stands near a heavy bedroom door. Deep shadows stretch across the polished floorboards. The atmosphere is eerie, quiet, and cool, with a mix of silver moonlight and deep charcoal darkness."
          },
          {
            "identifier": "SCENE_SECRET_CHAMBER",
            "location_header": "INT. SECRET CHAMBER - NIGHT",
            "visual_description": "A cramped, dusty secret chamber inside a thick stone wall. A single beam of moonlight cuts through a narrow slit window, highlighting floating dust motes and cobwebs. Rough-hewn stone walls encompass the space. A heavy timber beam crosses the low ceiling. The atmosphere is ancient, claustrophobic, and cold."
          }
        ]
      },
      "background_key": null,
      "audio_key": "publications/c83960b8fc4df8d871352b2a0a657a1b95fb656a/segments/2/audio.mp3",
