  "scenes": [
    {
      "identifier": "QUINCE_WORKSHOP",
      "ordinal": 0,
      "location_header": "ACT IV, SCENE 2",
      "visual_description": "Ancient Athens, 1200 BC. A cramped carpenter's workshop filled with tools, wood shavings, and sawdust. Afternoon sunlight filters through a small, dusty window, illuminating floating motes. Rough wooden benches and scattered parchment scrolls clutter the space. Earthy browns, warm ambers, and dusty textures. Cluttered, rustic, and industrious atmosphere.",
      "metadata": {},
      "image_key": "publications/759db4c17a42ab6cc39642ac4cfd7d24eeb4b03e/scenes/scene_QUINCE_WORKSHOP.jpg"
    },
    {
      "identifier": "FOREST_MOONLIGHT",
      "ordinal": 0,
      "location_header": "ACT IV, SCENE 1 (Part 1)",
      "visual_description": "Ancient Athens, 1200 BC. A mystical, ancient forest at night. Silver moonlight filters through the gnarled branches of massive oak trees, casting deep, dappled shadows on the mossy ground. Wildflowers glow faintly in the darkness. A raised grassy bank sits in the background. Deep blues, silvers, and forest greens dominate. Mysterious, magical, and organic atmosphere.",
      "metadata": {},
      "image_key": "publications/759db4c17a42ab6cc39642ac4cfd7d24eeb4b03e/scenes/scene_FOREST_MOONLIGHT.jpg"
    },
    {
      "identifier": "ATHENS_PALACE_NIGHT",
      "ordinal": 0,
      "location_header": "ACT V",
      "visual_description": "Ancient Athens, 1200 BC. The grand palace hall at night, illuminated by flickering torchlight and glowing braziers. Deep shadows play between the towering marble columns. Rich purple banners appear dark in the dim light. In the foreground, banquet tables are cleared but festive. Warm, regal, and intimate atmosphere.",
      "metadata": {},
      "image_key": "publications/759db4c17a42ab6cc39642ac4cfd7d24eeb4b03e/scenes/scene_ATHENS_PALACE_NIGHT.jpg"
    },
    {
      "identifier": "ATHENS_PALACE_DAY",
      "ordinal": 0,
      "location_header": "ACT I, SCENE 1",
      "visual_description": "Ancient Athens, 1200 BC. A grand palace hall featuring towering white marble columns and open archways. Bright Mediterranean sunlight streams in, illuminating dancing dust motes. Rich purple banners drape from the stone walls. In the foreground, a polished marble floor reflects the light. Gold and ivory accents adorn the space. Majestic, formal, and airy atmosphere.",
      "metadata": {},
      "image_key": "publications/759db4c17a42ab6cc39642ac4cfd7d24eeb4b03e/scenes/scene_ATHENS_PALACE_DAY.jpg"
    },
