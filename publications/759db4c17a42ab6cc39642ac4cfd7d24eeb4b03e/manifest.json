    {
      "ordinal": 2,
      "title": "SCENE I. Athens. A room in the Palace of Theseus",
      "start_s": 8.648,
      "end_s": 759.68,
      "part_ordinal": 0,
      "metadata": {
        "scenes": [
          {
            "identifier": "ATHENS_PALACE_DAY",
            "location_header": "ACT I, SCENE 1",
            "visual_description": "Ancient Athens, 1200 BC. A grand palace hall featuring towering white marble columns and open archways. Bright Mediterranean sunlight streams in, illuminating dancing dust motes. Rich purple banners drape from the stone walls. In the foreground, a polished marble floor reflects the light. Gold and ivory accents adorn the space. Majestic, formal, and airy atmosphere."
          }
        ]
      },
      "background_key": null
    },
    {
      "ordinal": 3,
      "title": "SCENE II. The Same. A Room in a Cottage",
      "start_s": 759.68,
      "end_s": 1054.42,
      "part_ordinal": 0,
      "metadata": {
        "scenes": [
          {
            "identifier": "QUINCE_WORKSHOP",
            "location_header": "ACT I, SCENE 2",
            "visual_description": "Ancient Athens, 1200 BC. A cramped carpenter's workshop filled with tools, wood shavings, and sawdust. Afternoon sunlight filters through a small, dusty window, illuminating floating motes. Rough wooden benches and scattered parchment scrolls clutter the space. Earthy browns, warm ambers, and dusty textures. Cluttered, rustic, and industrious atmosphere."
          }
        ]
      },
      "background_key": null
    },
    {
