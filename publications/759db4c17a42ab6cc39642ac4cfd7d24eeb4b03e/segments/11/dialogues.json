[
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 0,
    "text": "Deep in the enchanted wood, the four Athenian lovers lie in heavy slumber. Titania enters, winding her arms around the transformed Bottom, attended by her train of fairies. Oberon watches unseen from the shadows.",
    "speed": 1.0,
    "audio_description": "calm, atmospheric",
    "trailing_silence_s": 0.5,
    "start_s": 0.0,
    "end_s": 13.936327,
    "duration_s": 13.936327
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 1,
    "text": "Come, sit thee down upon this flowery bed, While I thy amiable cheeks do coy, And stick musk-roses in thy sleek smooth head, And kiss thy fair large ears, my gentle joy.",
    "speed": 1.0,
    "audio_description": "doting, affectionate",
    "trailing_silence_s": 0.2,
    "start_s": 13.936327,
    "end_s": 26.042994,
    "duration_s": 12.106667
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 2,
    "text": "Where’s Peaseblossom?",
    "speed": 1.0,
    "audio_description": "gruff, demanding",
    "trailing_silence_s": 0.2,
    "start_s": 26.042994,
    "end_s": 27.545035,
    "duration_s": 1.502041
  },
  {
    "character_identifier": "PEASEBLOSSOM",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 3,
    "text": "Ready.",
    "speed": 1.0,
    "audio_description": "eager, high-pitched",
    "trailing_silence_s": 0.2,
    "start_s": 27.545035,
    "end_s": 28.289524999999998,
    "duration_s": 0.74449
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 4,
    "text": "Scratch my head, Peaseblossom. Where’s Monsieur Cobweb?",
    "speed": 1.0,
    "audio_description": "itchy, commanding",
    "trailing_silence_s": 0.2,
    "start_s": 28.289524999999998,
    "end_s": 31.956191999999998,
    "duration_s": 3.666667
  },
  {
    "character_identifier": "COBWEB",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 5,
    "text": "Ready.",
    "speed": 1.0,
    "audio_description": "delicate, prompt",
    "trailing_silence_s": 0.2,
    "start_s": 31.956191999999998,
    "end_s": 32.742858999999996,
    "duration_s": 0.786667
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 6,
    "text": "Monsieur Cobweb; good monsieur, get you your weapons in your hand and kill me a red-hipped humble-bee on the top of a thistle; and, good monsieur, bring me the honey-bag.",
    "speed": 1.0,
    "audio_description": "bossy, comfortable",
    "trailing_silence_s": 0.2,
    "start_s": 32.742858999999996,
    "end_s": 42.917553,
    "duration_s": 10.174694
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 7,
    "text": "Do not fret yourself too much in the action, monsieur; and, good monsieur, have a care the honey-bag break not; I would be loath to have you overflown with a honey-bag, signior. Where’s Monsieur Mustardseed?",
    "speed": 1.0,
    "audio_description": "condescendingly kind",
    "trailing_silence_s": 0.2,
    "start_s": 42.917553,
    "end_s": 54.607349,
    "duration_s": 11.689796
  },
  {
    "character_identifier": "MUSTARDSEED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 8,
    "text": "Ready.",
    "speed": 1.0,
    "audio_description": "snappy, alert",
    "trailing_silence_s": 0.2,
    "start_s": 54.607349,
    "end_s": 55.593744,
    "duration_s": 0.986395
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 9,
    "text": "Give me your neaf, Monsieur Mustardseed. Pray you, leave your courtesy, good monsieur.",
    "speed": 1.0,
    "audio_description": "magnanimous",
    "trailing_silence_s": 0.2,
    "start_s": 55.593744,
    "end_s": 60.125989000000004,
    "duration_s": 4.532245
  },
  {
    "character_identifier": "MUSTARDSEED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 10,
    "text": "What’s your will?",
    "speed": 1.0,
    "audio_description": "servile",
    "trailing_silence_s": 0.2,
    "start_s": 60.125989000000004,
    "end_s": 61.15265600000001,
    "duration_s": 1.026667
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 11,
    "text": "Nothing, good monsieur, but to help Cavalery Cobweb to scratch. I must to the barber’s, monsieur, for methinks I am marvellous hairy about the face; and I am such a tender ass, if my hair do but tickle me, I must scratch.",
    "speed": 1.0,
    "audio_description": "itchy, complaining",
    "trailing_silence_s": 0.2,
    "start_s": 61.15265600000001,
    "end_s": 74.419323,
    "duration_s": 13.266667
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 12,
    "text": "What, wilt thou hear some music, my sweet love?",
    "speed": 1.0,
    "audio_description": "solicitous, loving",
    "trailing_silence_s": 0.2,
    "start_s": 74.419323,
    "end_s": 77.60599,
    "duration_s": 3.186667
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 13,
    "text": "I have a reasonable good ear in music. Let us have the tongs and the bones.",
    "speed": 1.0,
    "audio_description": "confident, crude",
    "trailing_silence_s": 0.2,
    "start_s": 77.60599,
    "end_s": 82.03374500000001,
    "duration_s": 4.427755
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 14,
    "text": "Rough, clanging music briefly disturbs the magical silence.",
    "speed": 1.0,
    "audio_description": "descriptive",
    "trailing_silence_s": 0.5,
    "start_s": 82.03374500000001,
    "end_s": 85.70394900000001,
    "duration_s": 3.670204
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 15,
    "text": "Or say, sweet love, what thou desirest to eat.",
    "speed": 1.0,
    "audio_description": "tender",
    "trailing_silence_s": 0.2,
    "start_s": 85.70394900000001,
    "end_s": 89.410616,
    "duration_s": 3.706667
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 16,
    "text": "Truly, a peck of provender; I could munch your good dry oats. Methinks I have a great desire to a bottle of hay: good hay, sweet hay, hath no fellow.",
    "speed": 1.0,
    "audio_description": "hungry, animalistic",
    "trailing_silence_s": 0.2,
    "start_s": 89.410616,
    "end_s": 99.820412,
    "duration_s": 10.409796
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 17,
    "text": "I have a venturous fairy that shall seek The squirrel’s hoard, and fetch thee new nuts.",
    "speed": 1.0,
    "audio_description": "promising",
    "trailing_silence_s": 0.2,
    "start_s": 99.820412,
    "end_s": 105.00680700000001,
    "duration_s": 5.186395
  },
  {
    "character_identifier": "BOTTOM_TRANSFORMED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 18,
    "text": "I had rather have a handful or two of dried peas. But, I pray you, let none of your people stir me; I have an exposition of sleep come upon me.",
    "speed": 1.0,
    "audio_description": "drowsy, firm",
    "trailing_silence_s": 0.5,
    "start_s": 105.00680700000001,
    "end_s": 114.26721500000001,
    "duration_s": 9.260408
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 19,
    "text": "Sleep thou, and I will wind thee in my arms. Fairies, be gone, and be all ways away.",
    "speed": 1.0,
    "audio_description": "commanding, soft",
    "trailing_silence_s": 0.2,
    "start_s": 114.26721500000001,
    "end_s": 121.133882,
    "duration_s": 6.866667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 20,
    "text": "The fairies vanish into the shadows.",
    "speed": 1.0,
    "audio_description": "whispered",
    "trailing_silence_s": 0.2,
    "start_s": 121.133882,
    "end_s": 123.133882,
    "duration_s": 2.0
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 21,
    "text": "So doth the woodbine the sweet honeysuckle Gently entwist, the female ivy so Enrings the barky fingers of the elm. O, how I love thee! How I dote on thee!",
    "speed": 1.0,
    "audio_description": "passionate, quiet",
    "trailing_silence_s": 1.0,
    "start_s": 123.133882,
    "end_s": 135.800549,
    "duration_s": 12.666667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 22,
    "text": "They drift into sleep. Oberon advances from the darkness, and Puck appears at his side.",
    "speed": 1.0,
    "audio_description": "mysterious",
    "trailing_silence_s": 0.5,
    "start_s": 135.800549,
    "end_s": 141.325447,
    "duration_s": 5.524898
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 23,
    "text": "Welcome, good Robin. Seest thou this sweet sight? Her dotage now I do begin to pity. For, meeting her of late behind the wood, Seeking sweet favours for this hateful fool, I did upbraid her and fall out with her:",
    "speed": 1.0,
    "audio_description": "confessional, commanding",
    "trailing_silence_s": 0.2,
    "start_s": 141.325447,
    "end_s": 154.765447,
    "duration_s": 13.44
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 24,
    "text": "For she his hairy temples then had rounded With coronet of fresh and fragrant flowers; And that same dew, which sometime on the buds Was wont to swell like round and orient pearls, Stood now within the pretty flouriets’ eyes, Like tears that did their own disgrace bewail.",
    "speed": 1.0,
    "audio_description": "poetic, sympathetic",
    "trailing_silence_s": 0.2,
    "start_s": 154.765447,
    "end_s": 175.5981,
    "duration_s": 20.832653
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 25,
    "text": "When I had at my pleasure taunted her, And she in mild terms begg’d my patience, I then did ask of her her changeling child; Which straight she gave me, and her fairy sent To bear him to my bower in fairyland.",
    "speed": 1.0,
    "audio_description": "satisfied, triumphant",
    "trailing_silence_s": 0.2,
    "start_s": 175.5981,
    "end_s": 189.22476699999999,
    "duration_s": 13.626667
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 26,
    "text": "And now I have the boy, I will undo This hateful imperfection of her eyes. And, gentle Puck, take this transformèd scalp From off the head of this Athenian swain, That he awaking when the other do, May all to Athens back again repair, And think no more of this night’s accidents But as the fierce vexation of a dream.",
    "speed": 1.0,
    "audio_description": "benevolent, commanding",
    "trailing_silence_s": 0.2,
    "start_s": 189.22476699999999,
    "end_s": 208.01986899999997,
    "duration_s": 18.795102
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 27,
    "text": "But first I will release the Fairy Queen.",
    "speed": 1.0,
    "audio_description": "gentle",
    "trailing_silence_s": 0.2,
    "start_s": 208.01986899999997,
    "end_s": 210.74966499999996,
    "duration_s": 2.729796
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 28,
    "text": "Oberon touches an herb to Titania's closed eyelids.",
    "speed": 1.0,
    "audio_description": "hushed",
    "trailing_silence_s": 0.5,
    "start_s": 210.74966499999996,
    "end_s": 214.08966499999997,
    "duration_s": 3.34
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 29,
    "text": "Be as thou wast wont to be; See as thou was wont to see. Dian’s bud o’er Cupid’s flower Hath such force and blessed power. Now, my Titania, wake you, my sweet queen.",
    "speed": 1.0,
    "audio_description": "incanting, powerful",
    "trailing_silence_s": 0.5,
    "start_s": 214.08966499999997,
    "end_s": 226.57726099999996,
    "duration_s": 12.487596
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 30,
    "text": "My Oberon, what visions have I seen! Methought I was enamour’d of an ass.",
    "speed": 1.0,
    "audio_description": "waking, horrified",
    "trailing_silence_s": 0.2,
    "start_s": 226.57726099999996,
    "end_s": 231.52392799999996,
    "duration_s": 4.946667
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 31,
    "text": "There lies your love.",
    "speed": 1.0,
    "audio_description": "calm, pointing",
    "trailing_silence_s": 0.2,
    "start_s": 231.52392799999996,
    "end_s": 232.97372399999995,
    "duration_s": 1.449796
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 32,
    "text": "How came these things to pass? O, how mine eyes do loathe his visage now!",
    "speed": 1.0,
    "audio_description": "disgusted, confused",
    "trailing_silence_s": 0.2,
    "start_s": 232.97372399999995,
    "end_s": 237.68882599999995,
    "duration_s": 4.715102
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 33,
    "text": "Silence awhile.—Robin, take off this head. Titania, music call; and strike more dead Than common sleep, of all these five the sense.",
    "speed": 1.0,
    "audio_description": "authoritative",
    "trailing_silence_s": 0.2,
    "start_s": 237.68882599999995,
    "end_s": 247.41943799999996,
    "duration_s": 9.730612
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 34,
    "text": "Music, ho, music, such as charmeth sleep.",
    "speed": 1.0,
    "audio_description": "commanding, musical",
    "trailing_silence_s": 0.5,
    "start_s": 247.41943799999996,
    "end_s": 251.22610499999996,
    "duration_s": 3.806667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 35,
    "text": "As soothing, magical music fills the air, Puck pulls the donkey head from Bottom's shoulders.",
    "speed": 1.0,
    "audio_description": "magical",
    "trailing_silence_s": 0.2,
    "start_s": 251.22610499999996,
    "end_s": 256.56814599999996,
    "duration_s": 5.342041
  },
  {
    "character_identifier": "PUCK",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 36,
    "text": "Now when thou wak’st, with thine own fool’s eyes peep.",
    "speed": 1.0,
    "audio_description": "mischievous, whisper",
    "trailing_silence_s": 0.2,
    "start_s": 256.56814599999996,
    "end_s": 259.95100299999996,
    "duration_s": 3.382857
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 37,
    "text": "Sound, music. Come, my queen, take hands with me, And rock the ground whereon these sleepers be.",
    "speed": 1.0,
    "audio_description": "regal, rhythmical",
    "trailing_silence_s": 0.2,
    "start_s": 259.95100299999996,
    "end_s": 267.41766999999993,
    "duration_s": 7.466667
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 38,
    "text": "Now thou and I are new in amity, And will tomorrow midnight solemnly Dance in Duke Theseus’ house triumphantly, And bless it to all fair prosperity: There shall the pairs of faithful lovers be Wedded, with Theseus, all in jollity.",
    "speed": 1.0,
    "audio_description": "prophetic, joyous",
    "trailing_silence_s": 0.2,
    "start_s": 267.41766999999993,
    "end_s": 284.28433699999994,
    "duration_s": 16.866667
  },
  {
    "character_identifier": "PUCK",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 39,
    "text": "Fairy king, attend and mark. I do hear the morning lark.",
    "speed": 1.0,
    "audio_description": "urgent, alert",
    "trailing_silence_s": 0.2,
    "start_s": 284.28433699999994,
    "end_s": 287.92841899999996,
    "duration_s": 3.644082
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 40,
    "text": "Then, my queen, in silence sad, Trip we after night’s shade. We the globe can compass soon, Swifter than the wand’ring moon.",
    "speed": 1.0,
    "audio_description": "hasty, lyrical",
    "trailing_silence_s": 0.2,
    "start_s": 287.92841899999996,
    "end_s": 296.22229699999997,
    "duration_s": 8.293878
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 41,
    "text": "Come, my lord, and in our flight, Tell me how it came this night That I sleeping here was found With these mortals on the ground.",
    "speed": 1.0,
    "audio_description": "curious, departing",
    "trailing_silence_s": 0.5,
    "start_s": 296.22229699999997,
    "end_s": 303.34066399999995,
    "duration_s": 7.118367
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 42,
    "text": "The fairy royals vanish into the ether as the sound of hunting horns pierces the distance.",
    "speed": 1.0,
    "audio_description": "transitional",
    "trailing_silence_s": 1.0,
    "start_s": 303.34066399999995,
    "end_s": 309.17903099999995,
    "duration_s": 5.838367
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 43,
    "text": "Morning mist rolls through the forest as the sun rises. The clamor of the hunt approaches, and Duke Theseus enters with Hippolyta and Egeus.",
    "speed": 1.0,
    "audio_description": "bright, active",
    "trailing_silence_s": 0.5,
    "start_s": 309.17903099999995,
    "end_s": 317.62964299999993,
    "duration_s": 8.450612
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 44,
    "text": "Go, one of you, find out the forester; For now our observation is perform’d; And since we have the vaward of the day, My love shall hear the music of my hounds.",
    "speed": 1.0,
    "audio_description": "energetic, royal",
    "trailing_silence_s": 0.2,
    "start_s": 317.62964299999993,
    "end_s": 327.56923499999994,
    "duration_s": 9.939592
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 45,
    "text": "Uncouple in the western valley; let them go. Dispatch I say, and find the forester.",
    "speed": 1.0,
    "audio_description": "commanding, loud",
    "trailing_silence_s": 0.5,
    "start_s": 327.56923499999994,
    "end_s": 333.51209199999994,
    "duration_s": 5.942857
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 46,
    "text": "We will, fair queen, up to the mountain’s top, And mark the musical confusion Of hounds and echo in conjunction.",
    "speed": 1.0,
    "audio_description": "appreciative",
    "trailing_silence_s": 0.2,
    "start_s": 333.51209199999994,
    "end_s": 340.13875899999994,
    "duration_s": 6.626667
  },
  {
    "character_identifier": "HIPPOLYTA",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 47,
    "text": "I was with Hercules and Cadmus once, When in a wood of Crete they bay’d the bear With hounds of Sparta. Never did I hear Such gallant chiding; for, besides the groves, The skies, the fountains, every region near Seem’d all one mutual cry.",
    "speed": 1.0,
    "audio_description": "reminiscent, strong",
    "trailing_silence_s": 0.2,
    "start_s": 340.13875899999994,
    "end_s": 354.6054259999999,
    "duration_s": 14.466667
  },
  {
    "character_identifier": "HIPPOLYTA",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 48,
    "text": "I never heard So musical a discord, such sweet thunder.",
    "speed": 1.0,
    "audio_description": "admiring",
    "trailing_silence_s": 0.2,
    "start_s": 354.6054259999999,
    "end_s": 358.5107319999999,
    "duration_s": 3.905306
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 49,
    "text": "My hounds are bred out of the Spartan kind, So flew’d, so sanded; and their heads are hung With ears that sweep away the morning dew; Crook-knee’d and dewlap’d like Thessalian bulls; Slow in pursuit, but match’d in mouth like bells, Each under each.",
    "speed": 1.0,
    "audio_description": "proud, knowledgeable",
    "trailing_silence_s": 0.2,
    "start_s": 358.5107319999999,
    "end_s": 373.4658339999999,
    "duration_s": 14.955102
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 50,
    "text": "A cry more tuneable Was never holla’d to, nor cheer’d with horn, In Crete, in Sparta, nor in Thessaly. Judge when you hear.—But, soft, what nymphs are these?",
    "speed": 1.0,
    "audio_description": "boasting, surprised",
    "trailing_silence_s": 0.2,
    "start_s": 373.4658339999999,
    "end_s": 382.9725009999999,
    "duration_s": 9.506667
  },
  {
    "character_identifier": "EGEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 51,
    "text": "My lord, this is my daughter here asleep, And this Lysander; this Demetrius is; This Helena, old Nedar’s Helena: I wonder of their being here together.",
    "speed": 1.0,
    "audio_description": "shocked, realizing",
    "trailing_silence_s": 0.2,
    "start_s": 382.9725009999999,
    "end_s": 393.2255619999999,
    "duration_s": 10.253061
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 52,
    "text": "No doubt they rose up early to observe The rite of May; and, hearing our intent, Came here in grace of our solemnity. But speak, Egeus; is not this the day That Hermia should give answer of her choice?",
    "speed": 1.0,
    "audio_description": "thoughtful, inquiring",
    "trailing_silence_s": 0.2,
    "start_s": 393.2255619999999,
    "end_s": 405.4122289999999,
    "duration_s": 12.186667
  },
  {
    "character_identifier": "EGEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 53,
    "text": "It is, my lord.",
    "speed": 1.0,
    "audio_description": "stern",
    "trailing_silence_s": 0.2,
    "start_s": 405.4122289999999,
    "end_s": 406.6530449999999,
    "duration_s": 1.240816
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 54,
    "text": "Go, bid the huntsmen wake them with their horns.",
    "speed": 1.0,
    "audio_description": "commanding",
    "trailing_silence_s": 0.5,
    "start_s": 406.6530449999999,
    "end_s": 410.1665139999999,
    "duration_s": 3.513469
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 55,
    "text": "A loud blast of horns echoes through the glade. The four lovers startle awake and scramble to their feet.",
    "speed": 1.0,
    "audio_description": "sudden, loud",
    "trailing_silence_s": 0.5,
    "start_s": 410.1665139999999,
    "end_s": 416.6318199999999,
    "duration_s": 6.465306
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 56,
    "text": "Good morrow, friends. Saint Valentine is past. Begin these wood-birds but to couple now?",
    "speed": 1.0,
    "audio_description": "amused, benevolent",
    "trailing_silence_s": 0.2,
    "start_s": 416.6318199999999,
    "end_s": 422.1828399999999,
    "duration_s": 5.55102
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 57,
    "text": "Pardon, my lord.",
    "speed": 1.0,
    "audio_description": "humble, shaky",
    "trailing_silence_s": 0.2,
    "start_s": 422.1828399999999,
    "end_s": 424.0495069999999,
    "duration_s": 1.866667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 58,
    "text": "Lysander and the others kneel before the Duke.",
    "speed": 1.0,
    "audio_description": "visual",
    "trailing_silence_s": 0.2,
    "start_s": 424.0495069999999,
    "end_s": 426.9695069999999,
    "duration_s": 2.92
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 59,
    "text": "I pray you all, stand up. I know you two are rival enemies. How comes this gentle concord in the world, That hatred is so far from jealousy To sleep by hate, and fear no enmity?",
    "speed": 1.0,
    "audio_description": "curious, questioning",
    "trailing_silence_s": 0.2,
    "start_s": 426.9695069999999,
    "end_s": 437.2225679999999,
    "duration_s": 10.253061
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 60,
    "text": "My lord, I shall reply amazedly, Half sleep, half waking; but as yet, I swear, I cannot truly say how I came here. But, as I think (for truly would I speak) And now I do bethink me, so it is: I came with Hermia hither.",
    "speed": 1.0,
    "audio_description": "confused, honest",
    "trailing_silence_s": 0.2,
    "start_s": 437.2225679999999,
    "end_s": 451.8642009999999,
    "duration_s": 14.641633
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 61,
    "text": "Our intent Was to be gone from Athens, where we might be Without the peril of the Athenian law.",
    "speed": 1.0,
    "audio_description": "confessing",
    "trailing_silence_s": 0.2,
    "start_s": 451.8642009999999,
    "end_s": 457.6908679999999,
    "duration_s": 5.826667
  },
  {
    "character_identifier": "EGEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 62,
    "text": "Enough, enough, my lord; you have enough. I beg the law, the law upon his head. They would have stol’n away, they would, Demetrius, Thereby to have defeated you and me: You of your wife, and me of my consent, Of my consent that she should be your wife.",
    "speed": 1.0,
    "audio_description": "furious, demanding",
    "trailing_silence_s": 0.5,
    "start_s": 457.6908679999999,
    "end_s": 472.5676029999999,
    "duration_s": 14.876735
  },
  {
    "character_identifier": "DEMETRIUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 63,
    "text": "My lord, fair Helen told me of their stealth, Of this their purpose hither to this wood; And I in fury hither follow’d them, Fair Helena in fancy following me. But, my good lord, I wot not by what power, (But by some power it is) my love to Hermia, Melted as the snow, seems to me now As the remembrance of an idle gaud Which in my childhood I did dote upon;",
    "speed": 1.0,
    "audio_description": "earnest, revealing",
    "trailing_silence_s": 0.2,
    "start_s": 472.5676029999999,
    "end_s": 495.6729089999999,
    "duration_s": 23.105306
  },
  {
    "character_identifier": "DEMETRIUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 64,
    "text": "And all the faith, the virtue of my heart, The object and the pleasure of mine eye, Is only Helena. To her, my lord, Was I betroth’d ere I saw Hermia. But like a sickness did I loathe this food. But, as in health, come to my natural taste, Now I do wish it, love it, long for it, And will for evermore be true to it.",
    "speed": 1.0,
    "audio_description": "passionate, resolved",
    "trailing_silence_s": 0.2,
    "start_s": 495.6729089999999,
    "end_s": 517.8900519999999,
    "duration_s": 22.217143
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 65,
    "text": "Fair lovers, you are fortunately met. Of this discourse we more will hear anon. Egeus, I will overbear your will; For in the temple, by and by with us, These couples shall eternally be knit.",
    "speed": 1.0,
    "audio_description": "decisive, royal",
    "trailing_silence_s": 0.2,
    "start_s": 517.8900519999999,
    "end_s": 530.6767189999998,
    "duration_s": 12.786667
  },
  {
    "character_identifier": "THESEUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 66,
    "text": "And, for the morning now is something worn, Our purpos’d hunting shall be set aside. Away with us to Athens. Three and three, We’ll hold a feast in great solemnity. Come, Hippolyta.",
    "speed": 1.0,
    "audio_description": "celebratory",
    "trailing_silence_s": 0.5,
    "start_s": 530.6767189999998,
    "end_s": 542.4448819999998,
    "duration_s": 11.768163
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 67,
    "text": "Theseus, Hippolyta, and Egeus depart, leaving the four lovers alone in the glade.",
    "speed": 1.0,
    "audio_description": "transitional",
    "trailing_silence_s": 0.5,
    "start_s": 542.4448819999998,
    "end_s": 547.6248819999997,
    "duration_s": 5.18
  },
  {
    "character_identifier": "DEMETRIUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 68,
    "text": "These things seem small and undistinguishable, Like far-off mountains turnèd into clouds.",
    "speed": 1.0,
    "audio_description": "dreamy, quiet",
    "trailing_silence_s": 0.2,
    "start_s": 547.6248819999997,
    "end_s": 554.3315489999998,
    "duration_s": 6.706667
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 69,
    "text": "Methinks I see these things with parted eye, When everything seems double.",
    "speed": 1.0,
    "audio_description": "dazed",
    "trailing_silence_s": 0.2,
    "start_s": 554.3315489999998,
    "end_s": 558.7582159999997,
    "duration_s": 4.426667
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 70,
    "text": "So methinks. And I have found Demetrius like a jewel, Mine own, and not mine own.",
    "speed": 1.0,
    "audio_description": "wondering",
    "trailing_silence_s": 0.2,
    "start_s": 558.7582159999997,
    "end_s": 564.9448829999997,
    "duration_s": 6.186667
  },
  {
    "character_identifier": "DEMETRIUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 71,
    "text": "Are you sure That we are awake? It seems to me That yet we sleep, we dream. Do not you think The Duke was here, and bid us follow him?",
    "speed": 1.0,
    "audio_description": "uncertain, testing",
    "trailing_silence_s": 0.2,
    "start_s": 564.9448829999997,
    "end_s": 573.1603929999997,
    "duration_s": 8.21551
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 72,
    "text": "Yea, and my father.",
    "speed": 1.0,
    "audio_description": "confirming",
    "trailing_silence_s": 0.1,
    "start_s": 573.1603929999997,
    "end_s": 574.8470599999996,
    "duration_s": 1.686667
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 73,
    "text": "And Hippolyta.",
    "speed": 1.0,
    "audio_description": "confirming",
    "trailing_silence_s": 0.1,
    "start_s": 574.8470599999996,
    "end_s": 576.1737269999996,
    "duration_s": 1.326667
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 74,
    "text": "And he did bid us follow to the temple.",
    "speed": 1.0,
    "audio_description": "confirming",
    "trailing_silence_s": 0.1,
    "start_s": 576.1737269999996,
    "end_s": 578.3288289999997,
    "duration_s": 2.155102
  },
  {
    "character_identifier": "DEMETRIUS",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 75,
    "text": "Why, then, we are awake: let’s follow him, And by the way let us recount our dreams.",
    "speed": 1.0,
    "audio_description": "relieved, active",
    "trailing_silence_s": 0.5,
    "start_s": 578.3288289999997,
    "end_s": 584.0627069999997,
    "duration_s": 5.733878
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 76,
    "text": "The lovers exit, hand in hand. A moment later, Bottom stirs from the bushes, stretching and yawning as he wakes.",
    "speed": 1.0,
    "audio_description": "humorous",
    "trailing_silence_s": 0.5,
    "start_s": 584.0627069999997,
    "end_s": 591.1810739999997,
    "duration_s": 7.118367
  },
  {
    "character_identifier": "BOTTOM",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 77,
    "text": "When my cue comes, call me, and I will answer. My next is ‘Most fair Pyramus.’ Heigh-ho! Peter Quince! Flute, the bellows-mender! Snout, the tinker! Starveling! God’s my life! Stol’n hence, and left me asleep!",
    "speed": 1.0,
    "audio_description": "groggy, panic",
    "trailing_silence_s": 0.2,
    "start_s": 591.1810739999997,
    "end_s": 604.0082619999997,
    "duration_s": 12.827188
  },
  {
    "character_identifier": "BOTTOM",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 78,
    "text": "I have had a most rare vision. I have had a dream, past the wit of man to say what dream it was. Man is but an ass if he go about to expound this dream. Methought I was—there is no man can tell what.",
    "speed": 1.0,
    "audio_description": "awed, confused",
    "trailing_silence_s": 0.2,
    "start_s": 604.0082619999997,
    "end_s": 616.2466289999998,
    "duration_s": 12.238367
  },
  {
    "character_identifier": "BOTTOM",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 79,
    "text": "Methought I was, and methought I had—but man is but a patched fool if he will offer to say what methought I had. The eye of man hath not heard, the ear of man hath not seen, man’s hand is not able to taste, his tongue to conceive, nor his heart to report, what my dream was.",
    "speed": 1.0,
    "audio_description": "philosophical, befuddled",
    "trailing_silence_s": 0.2,
    "start_s": 616.2466289999998,
    "end_s": 633.3960169999998,
    "duration_s": 17.149388
  },
  {
    "character_identifier": "BOTTOM",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 80,
    "text": "I will get Peter Quince to write a ballad of this dream: it shall be called ‘Bottom’s Dream’, because it hath no bottom; and I will sing it in the latter end of a play, before the Duke. Peradventure, to make it the more gracious, I shall sing it at her death.",
    "speed": 1.0,
    "audio_description": "inspired, triumphant",
    "trailing_silence_s": 0.5,
    "start_s": 633.3960169999998,
    "end_s": 647.8547929999997,
    "duration_s": 14.458776
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_DAWN",
    "ordinal": 81,
    "text": "Bursting with his new idea, Bottom hurries off towards Athens.",
    "speed": 1.0,
    "audio_description": "conclusive",
    "trailing_silence_s": 1.0,
    "start_s": 647.8547929999997,
    "end_s": 652.6947929999998,
    "duration_s": 4.84
  }
]