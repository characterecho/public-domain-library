[
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 0,
    "text": "Titania enters the moonlit glade, attended by her train of loyal spirits.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 0.0,
    "end_s": 4.56,
    "duration_s": 4.56
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 1,
    "text": "Come, now a roundel and a fairy song; Then for the third part of a minute, hence; Some to kill cankers in the musk-rose buds; Some war with reremice for their leathern wings, To make my small elves coats; and some keep back The clamorous owl, that nightly hoots and wonders At our quaint spirits.",
    "speed": 1.0,
    "audio_description": "regal, gentle",
    "trailing_silence_s": 0.2,
    "start_s": 4.56,
    "end_s": 24.347755,
    "duration_s": 19.787755
  },
  {
    "character_identifier": "TITANIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 2,
    "text": "Sing me now asleep; Then to your offices, and let me rest.",
    "speed": 1.0,
    "audio_description": "soft, weary",
    "trailing_silence_s": 0.5,
    "start_s": 24.347755,
    "end_s": 30.114421999999998,
    "duration_s": 5.766667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 3,
    "text": "The fairies gather around their queen to sing.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 30.114421999999998,
    "end_s": 32.834421999999996,
    "duration_s": 2.72
  },
  {
    "character_identifier": "PEASEBLOSSOM",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 4,
    "text": "You spotted snakes with double tongue, Thorny hedgehogs, be not seen; Newts and blind-worms do no wrong, Come not near our Fairy Queen.",
    "speed": 1.0,
    "audio_description": "singing, melodic",
    "trailing_silence_s": 0.5,
    "start_s": 32.834421999999996,
    "end_s": 42.87850399999999,
    "duration_s": 10.044082
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 5,
    "text": "The fairies sing in a hushed, magical unison: 'Philomel, with melody, Sing in our sweet lullaby: Lulla, lulla, lullaby; lulla, lulla, lullaby. Never harm, nor spell, nor charm, Come our lovely lady nigh; So good night, with lullaby.'",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 42.87850399999999,
    "end_s": 59.09850399999999,
    "duration_s": 16.22
  },
  {
    "character_identifier": "PEASEBLOSSOM",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 6,
    "text": "Weaving spiders, come not here; Hence, you long-legg’d spinners, hence. Beetles black, approach not near; Worm nor snail do no offence.",
    "speed": 1.0,
    "audio_description": "singing, protective",
    "trailing_silence_s": 0.5,
    "start_s": 59.09850399999999,
    "end_s": 68.78510299999999,
    "duration_s": 9.686599
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 7,
    "text": "The chorus repeats their soothing chant: 'Philomel with melody, et cetera'",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 68.78510299999999,
    "end_s": 73.578572,
    "duration_s": 4.793469
  },
  {
    "character_identifier": "MUSTARDSEED",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 8,
    "text": "Hence away! Now all is well. One aloof stand sentinel.",
    "speed": 1.0,
    "audio_description": "whispering, final",
    "trailing_silence_s": 1.0,
    "start_s": 73.578572,
    "end_s": 79.885239,
    "duration_s": 6.306667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 9,
    "text": "The fairies dissolve into the shadows, leaving Titania sleeping peacefully. Oberon emerges from the darkness, creeping toward his queen.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 79.885239,
    "end_s": 88.165239,
    "duration_s": 8.28
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 10,
    "text": "What thou seest when thou dost wake, Do it for thy true love take; Love and languish for his sake.",
    "speed": 1.0,
    "audio_description": "whispering, incanting",
    "trailing_silence_s": 0.2,
    "start_s": 88.165239,
    "end_s": 95.071883,
    "duration_s": 6.906644
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 11,
    "text": "Oberon squeezes the juice of the magical flower onto Titania's closed eyelids.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 95.071883,
    "end_s": 99.551883,
    "duration_s": 4.48
  },
  {
    "character_identifier": "OBERON",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 12,
    "text": "Be it ounce, or cat, or bear, Pard, or boar with bristled hair, In thy eye that shall appear When thou wak’st, it is thy dear. Wake when some vile thing is near.",
    "speed": 1.0,
    "audio_description": "menacing, quiet",
    "trailing_silence_s": 1.0,
    "start_s": 99.551883,
    "end_s": 114.428618,
    "duration_s": 14.876735
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 13,
    "text": "Oberon vanishes. Lysander and Hermia stumble into the clearing, exhausted.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 114.428618,
    "end_s": 119.148618,
    "duration_s": 4.72
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 14,
    "text": "Fair love, you faint with wand’ring in the wood. And, to speak troth, I have forgot our way. We’ll rest us, Hermia, if you think it good, And tarry for the comfort of the day.",
    "speed": 1.0,
    "audio_description": "tender, weary",
    "trailing_silence_s": 0.5,
    "start_s": 119.148618,
    "end_s": 133.189434,
    "duration_s": 14.040816
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 15,
    "text": "Be it so, Lysander: find you out a bed, For I upon this bank will rest my head.",
    "speed": 1.0,
    "audio_description": "gentle, tired",
    "trailing_silence_s": 0.5,
    "start_s": 133.189434,
    "end_s": 140.196101,
    "duration_s": 7.006667
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 16,
    "text": "One turf shall serve as pillow for us both; One heart, one bed, two bosoms, and one troth.",
    "speed": 1.0,
    "audio_description": "romantic, earnest",
    "trailing_silence_s": 0.5,
    "start_s": 140.196101,
    "end_s": 146.948754,
    "duration_s": 6.752653
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 17,
    "text": "Nay, good Lysander; for my sake, my dear, Lie further off yet, do not lie so near.",
    "speed": 1.0,
    "audio_description": "modest, firm",
    "trailing_silence_s": 0.5,
    "start_s": 146.948754,
    "end_s": 153.126713,
    "duration_s": 6.177959
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 18,
    "text": "O take the sense, sweet, of my innocence! Love takes the meaning in love’s conference. I mean that my heart unto yours is knit, So that but one heart we can make of it: Two bosoms interchainèd with an oath, So then two bosoms and a single troth.",
    "speed": 1.0,
    "audio_description": "earnest, pleading",
    "trailing_silence_s": 0.2,
    "start_s": 153.126713,
    "end_s": 168.63338,
    "duration_s": 15.506667
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 19,
    "text": "Then by your side no bed-room me deny; For lying so, Hermia, I do not lie.",
    "speed": 1.0,
    "audio_description": "playful, earnest",
    "trailing_silence_s": 0.5,
    "start_s": 168.63338,
    "end_s": 173.897053,
    "duration_s": 5.263673
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 20,
    "text": "Lysander riddles very prettily. Now much beshrew my manners and my pride, If Hermia meant to say Lysander lied!",
    "speed": 1.0,
    "audio_description": "amused, gentle",
    "trailing_silence_s": 0.2,
    "start_s": 173.897053,
    "end_s": 180.76372,
    "duration_s": 6.866667
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 21,
    "text": "But, gentle friend, for love and courtesy Lie further off, in human modesty, Such separation as may well be said Becomes a virtuous bachelor and a maid, So far be distant; and good night, sweet friend: Thy love ne’er alter till thy sweet life end!",
    "speed": 1.0,
    "audio_description": "modest, loving",
    "trailing_silence_s": 0.5,
    "start_s": 180.76372,
    "end_s": 198.69038700000002,
    "duration_s": 17.926667
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 22,
    "text": "Amen, amen, to that fair prayer say I; And then end life when I end loyalty! Here is my bed. Sleep give thee all his rest!",
    "speed": 1.0,
    "audio_description": "devoted, soft",
    "trailing_silence_s": 0.5,
    "start_s": 198.69038700000002,
    "end_s": 209.988346,
    "duration_s": 11.297959
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 23,
    "text": "With half that wish the wisher’s eyes be pressed!",
    "speed": 1.0,
    "audio_description": "sleepy, affectionate",
    "trailing_silence_s": 1.0,
    "start_s": 209.988346,
    "end_s": 213.684673,
    "duration_s": 3.696327
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 24,
    "text": "They settle down on the mossy ground to sleep, some distance apart. Puck bounds into the glade.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 213.684673,
    "end_s": 219.484922,
    "duration_s": 5.800249
  },
  {
    "character_identifier": "PUCK",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 25,
    "text": "Through the forest have I gone, But Athenian found I none, On whose eyes I might approve This flower’s force in stirring love.",
    "speed": 1.0,
    "audio_description": "mischievous, rhythmic",
    "trailing_silence_s": 0.2,
    "start_s": 219.484922,
    "end_s": 226.838391,
    "duration_s": 7.353469
  },
  {
    "character_identifier": "PUCK",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 26,
    "text": "Night and silence! Who is here? Weeds of Athens he doth wear: This is he, my master said, Despisèd the Athenian maid;",
    "speed": 1.0,
    "audio_description": "curious, triumphant",
    "trailing_silence_s": 0.2,
    "start_s": 226.838391,
    "end_s": 235.419615,
    "duration_s": 8.581224
  },
  {
    "character_identifier": "PUCK",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 27,
    "text": "And here the maiden, sleeping sound, On the dank and dirty ground. Pretty soul, she durst not lie Near this lack-love, this kill-courtesy.",
    "speed": 1.0,
    "audio_description": "sympathetic, judgemental",
    "trailing_silence_s": 0.2,
    "start_s": 235.419615,
    "end_s": 243.922472,
    "duration_s": 8.502857
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 28,
    "text": "Puck leans over Lysander and anoints his eyes with the magical juice.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 243.922472,
    "end_s": 247.749411,
    "duration_s": 3.826939
  },
  {
    "character_identifier": "PUCK",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 29,
    "text": "Churl, upon thy eyes I throw All the power this charm doth owe; When thou wak’st let love forbid Sleep his seat on thy eyelid. So awake when I am gone; For I must now to Oberon.",
    "speed": 1.0,
    "audio_description": "casting spell, energetic",
    "trailing_silence_s": 1.0,
    "start_s": 247.749411,
    "end_s": 258.211452,
    "duration_s": 10.462041
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 30,
    "text": "Puck vanishes. Demetrius rushes into the clearing, with Helena running breathlessly behind him.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 258.211452,
    "end_s": 263.851452,
    "duration_s": 5.64
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 31,
    "text": "Stay, though thou kill me, sweet Demetrius.",
    "speed": 1.0,
    "audio_description": "desperate, breathless",
    "trailing_silence_s": 0.5,
    "start_s": 263.851452,
    "end_s": 267.155942,
    "duration_s": 3.30449
  },
  {
    "character_identifier": "DEMETRIUS",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 32,
    "text": "I charge thee, hence, and do not haunt me thus.",
    "speed": 1.0,
    "audio_description": "angry, harsh",
    "trailing_silence_s": 0.5,
    "start_s": 267.155942,
    "end_s": 270.512677,
    "duration_s": 3.356735
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 33,
    "text": "O, wilt thou darkling leave me? Do not so.",
    "speed": 1.0,
    "audio_description": "pleading, sad",
    "trailing_silence_s": 0.5,
    "start_s": 270.512677,
    "end_s": 274.999344,
    "duration_s": 4.486667
  },
  {
    "character_identifier": "DEMETRIUS",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 34,
    "text": "Stay, on thy peril; I alone will go.",
    "speed": 1.0,
    "audio_description": "threatening, cold",
    "trailing_silence_s": 1.0,
    "start_s": 274.999344,
    "end_s": 279.244242,
    "duration_s": 4.244898
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 35,
    "text": "Demetrius breaks away and disappears into the dark woods.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 279.244242,
    "end_s": 282.26138499999996,
    "duration_s": 3.017143
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 36,
    "text": "O, I am out of breath in this fond chase! The more my prayer, the lesser is my grace. Happy is Hermia, wheresoe’er she lies, For she hath blessèd and attractive eyes.",
    "speed": 1.0,
    "audio_description": "winded, unhappy",
    "trailing_silence_s": 0.2,
    "start_s": 282.26138499999996,
    "end_s": 293.56805199999997,
    "duration_s": 11.306667
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 37,
    "text": "How came her eyes so bright? Not with salt tears. If so, my eyes are oftener wash’d than hers. No, no, I am as ugly as a bear, For beasts that meet me run away for fear: Therefore no marvel though Demetrius Do, as a monster, fly my presence thus.",
    "speed": 1.0,
    "audio_description": "self-pitying, bitter",
    "trailing_silence_s": 0.2,
    "start_s": 293.56805199999997,
    "end_s": 310.142746,
    "duration_s": 16.574694
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 38,
    "text": "What wicked and dissembling glass of mine Made me compare with Hermia’s sphery eyne? But who is here? Lysander, on the ground! Dead or asleep? I see no blood, no wound. Lysander, if you live, good sir, awake.",
    "speed": 1.0,
    "audio_description": "surprised, concerned",
    "trailing_silence_s": 0.5,
    "start_s": 310.142746,
    "end_s": 324.523154,
    "duration_s": 14.380408
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 39,
    "text": "Lysander wakes, the spell taking instant hold as he looks up at Helena.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 324.523154,
    "end_s": 328.74192999999997,
    "duration_s": 4.218776
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 40,
    "text": "And run through fire I will for thy sweet sake. Transparent Helena! Nature shows art, That through thy bosom makes me see thy heart. Where is Demetrius? O, how fit a word Is that vile name to perish on my sword!",
    "speed": 1.0,
    "audio_description": "intense, infatuated",
    "trailing_silence_s": 0.5,
    "start_s": 328.74192999999997,
    "end_s": 342.31254199999995,
    "duration_s": 13.570612
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 41,
    "text": "Do not say so, Lysander, say not so. What though he love your Hermia? Lord, what though? Yet Hermia still loves you. Then be content.",
    "speed": 1.0,
    "audio_description": "confused, placating",
    "trailing_silence_s": 0.5,
    "start_s": 342.31254199999995,
    "end_s": 350.99825599999997,
    "duration_s": 8.685714
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 42,
    "text": "Content with Hermia? No, I do repent The tedious minutes I with her have spent. Not Hermia, but Helena I love. Who will not change a raven for a dove?",
    "speed": 1.0,
    "audio_description": "dismissive, passionate",
    "trailing_silence_s": 0.2,
    "start_s": 350.99825599999997,
    "end_s": 361.042338,
    "duration_s": 10.044082
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 43,
    "text": "The will of man is by his reason sway’d, And reason says you are the worthier maid. Things growing are not ripe until their season; So I, being young, till now ripe not to reason;",
    "speed": 1.0,
    "audio_description": "philosophical, intense",
    "trailing_silence_s": 0.2,
    "start_s": 361.042338,
    "end_s": 372.000705,
    "duration_s": 10.958367
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 44,
    "text": "And touching now the point of human skill, Reason becomes the marshal to my will, And leads me to your eyes, where I o’erlook Love’s stories, written in love’s richest book.",
    "speed": 1.0,
    "audio_description": "romantic, obsessed",
    "trailing_silence_s": 0.5,
    "start_s": 372.000705,
    "end_s": 381.67907199999996,
    "duration_s": 9.678367
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 45,
    "text": "Wherefore was I to this keen mockery born? When at your hands did I deserve this scorn? Is’t not enough, is’t not enough, young man, That I did never, no, nor never can Deserve a sweet look from Demetrius’ eye, But you must flout my insufficiency?",
    "speed": 1.0,
    "audio_description": "hurt, indignant",
    "trailing_silence_s": 0.2,
    "start_s": 381.67907199999996,
    "end_s": 397.10573899999997,
    "duration_s": 15.426667
  },
  {
    "character_identifier": "HELENA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 46,
    "text": "Good troth, you do me wrong, good sooth, you do, In such disdainful manner me to woo. But fare you well; perforce I must confess, I thought you lord of more true gentleness. O, that a lady of one man refus’d, Should of another therefore be abus’d!",
    "speed": 1.0,
    "audio_description": "offended, tearful",
    "trailing_silence_s": 1.0,
    "start_s": 397.10573899999997,
    "end_s": 416.789004,
    "duration_s": 19.683265
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 47,
    "text": "Helena runs off, distressed. Lysander turns to look at the sleeping Hermia with disdain.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 416.789004,
    "end_s": 422.269004,
    "duration_s": 5.48
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 48,
    "text": "She sees not Hermia. Hermia, sleep thou there, And never mayst thou come Lysander near! For, as a surfeit of the sweetest things The deepest loathing to the stomach brings;",
    "speed": 1.0,
    "audio_description": "cold, disgusted",
    "trailing_silence_s": 0.2,
    "start_s": 422.269004,
    "end_s": 431.816759,
    "duration_s": 9.547755
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 49,
    "text": "Or as the heresies that men do leave Are hated most of those they did deceive; So thou, my surfeit and my heresy, Of all be hated, but the most of me!",
    "speed": 1.0,
    "audio_description": "hateful, firm",
    "trailing_silence_s": 0.2,
    "start_s": 431.816759,
    "end_s": 441.84342599999997,
    "duration_s": 10.026667
  },
  {
    "character_identifier": "LYSANDER",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 50,
    "text": "And, all my powers, address your love and might To honour Helen, and to be her knight!",
    "speed": 1.0,
    "audio_description": "determined, proclaiming",
    "trailing_silence_s": 1.0,
    "start_s": 441.84342599999997,
    "end_s": 447.31607899999995,
    "duration_s": 5.472653
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 51,
    "text": "Lysander runs after Helena. Hermia wakes with a start, trembling.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.0,
    "start_s": 447.31607899999995,
    "end_s": 451.11607899999996,
    "duration_s": 3.8
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 52,
    "text": "Help me, Lysander, help me! Do thy best To pluck this crawling serpent from my breast! Ay me, for pity! What a dream was here! Lysander, look how I do quake with fear.",
    "speed": 1.0,
    "audio_description": "terrified, frantic",
    "trailing_silence_s": 0.2,
    "start_s": 451.11607899999996,
    "end_s": 460.53322199999997,
    "duration_s": 9.417143
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 53,
    "text": "Methought a serpent eat my heart away, And you sat smiling at his cruel prey. Lysander! What, removed? Lysander! lord! What, out of hearing? Gone? No sound, no word?",
    "speed": 1.0,
    "audio_description": "desperate, confused",
    "trailing_silence_s": 0.2,
    "start_s": 460.53322199999997,
    "end_s": 474.28669099999996,
    "duration_s": 13.753469
  },
  {
    "character_identifier": "HERMIA",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 54,
    "text": "Alack, where are you? Speak, and if you hear; Speak, of all loves! I swoon almost with fear. No? Then I well perceive you are not nigh. Either death or you I’ll find immediately.",
    "speed": 1.0,
    "audio_description": "resolute, fearful",
    "trailing_silence_s": 1.0,
    "start_s": 474.28669099999996,
    "end_s": 485.71335799999997,
    "duration_s": 11.426667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "FOREST_MOONLIGHT",
    "ordinal": 55,
    "text": "Hermia rushes into the darkness in search of her love.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 1.0,
    "start_s": 485.71335799999997,
    "end_s": 489.43580699999995,
    "duration_s": 3.722449
  }
]