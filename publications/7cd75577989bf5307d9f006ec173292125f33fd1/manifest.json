  "scenes": [
    {
      "identifier": "SCENE_COVER_00",
      "ordinal": 0,
      "location_header": null,
      "visual_description": "A symbolic representation of the book's themes.",
      "metadata": {
        "type": "cover_placeholder"
      },
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_COVER_00.jpg"
    },
    {
      "identifier": "SCENE_COURTROOM",
      "ordinal": 0,
      "location_header": "INT. COURTROOM - DAY",
      "visual_description": "A chaotic Victorian courtroom in disarray. A wooden jury box is tipped over, spilling slate pencils and papers. The King and Queen sit on high crimson thrones in the background. High windows let in bright, harsh daylight. The atmosphere is frantic and absurd.",
      "metadata": {},
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_COURTROOM.jpg"
    },
    {
      "identifier": "SCENE_RABBIT_HOUSE",
      "ordinal": 0,
      "location_header": "EXT/INT. WHITE RABBIT'S HOUSE - DAY",
      "visual_description": "A neat Victorian cottage seen first from the exterior, then shifting to a cramped upper bedroom. Sunlight streams through a small sash window, illuminating a looking-glass and tiny furniture. The perspective is claustrophobic, dominated by the sense of an oversized presence filling the space. Bright whites, pastel yellows, and wood tones contrast with the chaotic, cramped atmosphere.",
      "metadata": {},
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_RABBIT_HOUSE.jpg"
    },
    {
      "identifier": "SCENE_DUCHESS_EXT",
      "ordinal": 0,
      "location_header": "EXT. DUCHESS'S HOUSE - DAY",
      "visual_description": "A chaotic Victorian cottage exterior nestled at the edge of a dark wood. The front door is large, imposing, and framed by heavy timber. Sunlight dapples the forest floor, contrasting with the solid, somewhat foreboding architecture of the house. Earthy browns, forest greens, and stone greys.",
      "metadata": {},
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_DUCHESS_EXT.jpg"
    },
    {
      "identifier": "SCENE_RABBIT_HOLE",
      "ordinal": 0,
      "location_header": "INT. RABBIT HOLE - DAY",
      "visual_description": "A surreal, vertical Victorian well shaft descending into darkness. The curved earthen walls are lined with domestic clutter: dark wood cupboards, bookshelves, and hung maps. Dim, mysterious lighting from above fades into deep shadow below. Muted browns and cooler shadows create a disorienting, dreamlike atmosphere.",
      "metadata": {},
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_RABBIT_HOLE.jpg"
    },
    {
      "identifier": "SCENE_ROCKY_LEDGE",
      "ordinal": 0,
      "location_header": "EXT. ROCKY LEDGE - DAY",
      "visual_description": "A lonely, sun-drenched rocky ledge overlooking a calm sea. Large, weathered boulders scatter the sandy foreground. To the side, jagged rocks form a natural seat. The light is bright but carries a melancholic stillness. Muted greys of the stone contrast with pale sand yellows and the soft blue of the distant horizon.",
      "metadata": {},
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_ROCKY_LEDGE.jpg"
    },
    {
      "identifier": "SCENE_POOL_OF_TEARS",
      "ordinal": 0,
      "location_header": "INT. POOL OF TEARS - UNDERGROUND",
      "visual_description": "A surreal, vast subterranean body of salt water filling the Victorian hall. The dark water stretches out, reflecting the dim light of hanging lamps high above. In the distance, a muddy shoreline is visible. Cool blues, murky greens, and deep shadows create a damp, melancholic atmosphere.",
      "metadata": {},
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_POOL_OF_TEARS.jpg"
    },
    {
      "identifier": "SCENE_WOOD",
      "ordinal": 0,
      "location_header": "EXT. THE WOOD - DAY",
      "visual_description": "A towering forest floor viewed from a microscopic perspective. Enormous blades of grass and wildflowers rise like trees above, creating a green canopy dappled with filtered sunlight. In the clearing stands a large mushroom with a blue tint. The atmosphere is vibrant but overwhelming, with rich greens, earthy browns, and soft diffused light.",
      "metadata": {},
      "image_key": "publications/7cd75577989bf5307d9f006ec173292125f33fd1/scenes/scene_SCENE_WOOD.jpg"
    },
    {
      "identifier": "SCENE_CROQUET_GROUND",
      "ordinal": 0,
      "location_header": "EXT. QUEEN'S CROQUET GROUND - DAY",
      "visual_description": "A surreal Victorian formal garden under bright, somewhat harsh afternoon light. Manicured hedges and rigid furrows line the ground. A large rose-tree stands prominently, its blossoms a mix of natural white and dripping red paint. In the background, manicured lawns stretch out towards distant pavilions. Vibrant greens, stark whites, and blood reds.",
      "metadata": {},
