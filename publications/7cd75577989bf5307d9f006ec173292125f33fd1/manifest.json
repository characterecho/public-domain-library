    {
      "ordinal": 1,
      "title": "CHAPTER I. Down the Rabbit-Hole",
      "start_s": 7.05102,
      "end_s": 608.560706,
      "part_ordinal": 0,
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_RABBIT_HOLE",
            "location_header": "INT. RABBIT HOLE - DAY",
            "visual_description": "A surreal, vertical Victorian well shaft descending into darkness. The curved earthen walls are lined with domestic clutter: dark wood cupboards, bookshelves, and hung maps. Dim, mysterious lighting from above fades into deep shadow below. Muted browns and cooler shadows create a disorienting, dreamlike atmosphere."
          },
          {
            "identifier": "SCENE_LONG_HALL",
            "location_header": "INT. LONG HALL - UNDERGROUND",
            "visual_description": "A long, low-ceilinged hallway lit by a row of warm hanging lamps. Lined with many locked wooden doors. In the foreground, a three-legged table made of solid glass with a tiny golden key on top. Warm artificial light contrasts with somewhat gloomy corners. Curious, slightly claustrophobic atmosphere."
          }
        ]
      },
      "background_key": null
    },
    {
      "ordinal": 2,
      "title": "CHAPTER II. The Pool of Tears",
      "start_s": 608.560706,
      "end_s": 1162.9549670000001,
