          },
          {
            "identifier": "SCENE_POOL_OF_TEARS",
            "location_header": "INT. POOL OF TEARS - UNDERGROUND",
            "visual_description": "A surreal, vast subterranean body of salt water filling the Victorian hall. The dark water stretches out, reflecting the dim light of hanging lamps high above. In the distance, a muddy shoreline is visible. Cool blues, murky greens, and deep shadows create a damp, melancholic atmosphere."
          }
        ]
      },
      "background_key": null
