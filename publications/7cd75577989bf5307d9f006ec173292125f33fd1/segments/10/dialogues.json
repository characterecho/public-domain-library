[
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 0,
    "text": "CHAPTER X. The Lobster Quadrille",
    "speed": 1.0,
    "audio_description": "",
    "trailing_silence_s": 1.0,
    "start_s": 0.0,
    "end_s": 3.28,
    "duration_s": 3.28,
    "title": true
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 1,
    "text": "The Mock Turtle sighed deeply, and drew the back of one flapper across his eyes. He looked at Alice, and tried to speak, but for a minute or two sobs choked his voice.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 3.28,
    "end_s": 12.827755,
    "duration_s": 9.547755
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 2,
    "text": "Same as if he had a bone in his throat.",
    "speed": 1.0,
    "audio_description": "gruff, dismissive",
    "trailing_silence_s": 0.2,
    "start_s": 12.827755,
    "end_s": 15.294422,
    "duration_s": 2.466667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 3,
    "text": "The Gryphon set to work shaking him and punching him in the back. At last the Mock Turtle recovered his voice, and, with tears running down his cheeks, he went on again.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 15.294422,
    "end_s": 25.674422,
    "duration_s": 10.38
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 4,
    "text": "You may not have lived much under the sea—",
    "speed": 1.0,
    "audio_description": "weeping, shaky",
    "trailing_silence_s": 0.2,
    "start_s": 25.674422,
    "end_s": 28.378095000000002,
    "duration_s": 2.703673
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 5,
    "text": "I haven’t.",
    "speed": 1.0,
    "audio_description": "polite, quiet",
    "trailing_silence_s": 0.2,
    "start_s": 28.378095000000002,
    "end_s": 29.246961000000002,
    "duration_s": 0.868866
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 6,
    "text": "—and perhaps you were never even introduced to a lobster—",
    "speed": 1.0,
    "audio_description": "melancholy",
    "trailing_silence_s": 0.2,
    "start_s": 29.246961000000002,
    "end_s": 34.223288000000004,
    "duration_s": 4.976327
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 7,
    "text": "I once tasted—",
    "speed": 1.0,
    "audio_description": "hasty",
    "trailing_silence_s": 0.1,
    "start_s": 34.223288000000004,
    "end_s": 35.522154,
    "duration_s": 1.298866
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 8,
    "text": "Alice checked herself hastily.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.1,
    "start_s": 35.522154,
    "end_s": 37.382154,
    "duration_s": 1.86
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 9,
    "text": "No, never.",
    "speed": 1.0,
    "audio_description": "correcting",
    "trailing_silence_s": 0.2,
    "start_s": 37.382154,
    "end_s": 38.66746,
    "duration_s": 1.285306
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 10,
    "text": "—so you can have no idea what a delightful thing a Lobster Quadrille is!",
    "speed": 1.0,
    "audio_description": "melancholy, enthusiastic",
    "trailing_silence_s": 0.5,
    "start_s": 38.66746,
    "end_s": 43.35644,
    "duration_s": 4.68898
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 11,
    "text": "No, indeed. What sort of a dance is it?",
    "speed": 1.0,
    "audio_description": "curious",
    "trailing_silence_s": 0.5,
    "start_s": 43.35644,
    "end_s": 46.478073,
    "duration_s": 3.121633
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 12,
    "text": "Why, you first form into a line along the sea-shore—",
    "speed": 1.0,
    "audio_description": "explanatory",
    "trailing_silence_s": 0.2,
    "start_s": 46.478073,
    "end_s": 49.678073000000005,
    "duration_s": 3.2
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 13,
    "text": "Two lines! Seals, turtles, salmon, and so on; then, when you’ve cleared all the jelly-fish out of the way—",
    "speed": 1.0,
    "audio_description": "correcting, excited",
    "trailing_silence_s": 0.2,
    "start_s": 49.678073000000005,
    "end_s": 55.882155000000004,
    "duration_s": 6.204082
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 14,
    "text": "That generally takes some time.",
    "speed": 1.0,
    "audio_description": "interrupting, dry",
    "trailing_silence_s": 0.2,
    "start_s": 55.882155000000004,
    "end_s": 57.668822000000006,
    "duration_s": 1.786667
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 15,
    "text": "—you advance twice—",
    "speed": 1.0,
    "audio_description": "continuing",
    "trailing_silence_s": 0.2,
    "start_s": 57.668822000000006,
    "end_s": 59.35372,
    "duration_s": 1.684898
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 16,
    "text": "Each with a lobster as a partner!",
    "speed": 1.0,
    "audio_description": "loud, energetic",
    "trailing_silence_s": 0.2,
    "start_s": 59.35372,
    "end_s": 61.169230000000006,
    "duration_s": 1.81551
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 17,
    "text": "Of course. Advance twice, set to partners—",
    "speed": 1.0,
    "audio_description": "matter-of-fact",
    "trailing_silence_s": 0.2,
    "start_s": 61.169230000000006,
    "end_s": 64.630454,
    "duration_s": 3.461224
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 18,
    "text": "—change lobsters, and retire in same order.",
    "speed": 1.0,
    "audio_description": "continuing",
    "trailing_silence_s": 0.2,
    "start_s": 64.630454,
    "end_s": 67.56923,
    "duration_s": 2.938776
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 19,
    "text": "Then, you know, you throw the—",
    "speed": 1.0,
    "audio_description": "building anticipation",
    "trailing_silence_s": 0.2,
    "start_s": 67.56923,
    "end_s": 69.675897,
    "duration_s": 2.106667
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 20,
    "text": "The lobsters!",
    "speed": 1.0,
    "audio_description": "shouting",
    "trailing_silence_s": 0.2,
    "start_s": 69.675897,
    "end_s": 70.759979,
    "duration_s": 1.084082
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 21,
    "text": "The Gryphon bounded into the air.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 70.759979,
    "end_s": 72.679979,
    "duration_s": 1.92
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 22,
    "text": "—as far out to sea as you can—",
    "speed": 1.0,
    "audio_description": "continuing",
    "trailing_silence_s": 0.2,
    "start_s": 72.679979,
    "end_s": 75.070183,
    "duration_s": 2.390204
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 23,
    "text": "Swim after them!",
    "speed": 1.0,
    "audio_description": "screaming",
    "trailing_silence_s": 0.3,
    "start_s": 75.070183,
    "end_s": 76.389367,
    "duration_s": 1.319184
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 24,
    "text": "Turn a somersault in the sea!",
    "speed": 1.0,
    "audio_description": "crying out",
    "trailing_silence_s": 0.2,
    "start_s": 76.389367,
    "end_s": 78.492224,
    "duration_s": 2.102857
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 25,
    "text": "The Mock Turtle capered wildly about.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 78.492224,
    "end_s": 80.692224,
    "duration_s": 2.2
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 26,
    "text": "Change lobsters again!",
    "speed": 1.0,
    "audio_description": "yelling",
    "trailing_silence_s": 0.3,
    "start_s": 80.692224,
    "end_s": 82.455489,
    "duration_s": 1.763265
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 27,
    "text": "Back to land again, and that’s all the first figure.",
    "speed": 1.0,
    "audio_description": "suddenly quiet, sad",
    "trailing_silence_s": 0.3,
    "start_s": 82.455489,
    "end_s": 86.142156,
    "duration_s": 3.686667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 28,
    "text": "The two creatures, who had been jumping about like mad things all this time, sat down again very sadly and quietly, and looked at Alice.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 86.142156,
    "end_s": 94.070319,
    "duration_s": 7.928163
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 29,
    "text": "It must be a very pretty dance.",
    "speed": 1.0,
    "audio_description": "timid",
    "trailing_silence_s": 0.3,
    "start_s": 94.070319,
    "end_s": 96.061385,
    "duration_s": 1.991066
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 30,
    "text": "Would you like to see a little of it?",
    "speed": 1.0,
    "audio_description": "hopeful",
    "trailing_silence_s": 0.3,
    "start_s": 96.061385,
    "end_s": 97.876895,
    "duration_s": 1.81551
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 31,
    "text": "Very much indeed.",
    "speed": 1.0,
    "audio_description": "polite",
    "trailing_silence_s": 0.3,
    "start_s": 97.876895,
    "end_s": 99.224355,
    "duration_s": 1.34746
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 32,
    "text": "Come, let’s try the first figure! We can do without lobsters, you know. Which shall sing?",
    "speed": 1.0,
    "audio_description": "energetic",
    "trailing_silence_s": 0.3,
    "start_s": 99.224355,
    "end_s": 104.90598800000001,
    "duration_s": 5.681633
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 33,
    "text": "Oh, you sing. I’ve forgotten the words.",
    "speed": 1.0,
    "audio_description": "dismissive",
    "trailing_silence_s": 0.5,
    "start_s": 104.90598800000001,
    "end_s": 108.10598800000001,
    "duration_s": 3.2
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 34,
    "text": "So they began solemnly dancing round and round Alice, every now and then treading on her toes when they passed too close, and waving their forepaws to mark the time, while the Mock Turtle sang this, very slowly and sadly:",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 108.10598800000001,
    "end_s": 121.36598800000002,
    "duration_s": 13.26
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 35,
    "text": "Will you walk a little faster? said a whiting to a snail. There’s a porpoise close behind us, and he’s treading on my tail. See how eagerly the lobsters and the turtles all advance! They are waiting on the shingle—will you come and join the dance?",
    "speed": 1.0,
    "audio_description": "singing, slow, sad",
    "trailing_silence_s": 0.2,
    "start_s": 121.36598800000002,
    "end_s": 137.83265500000002,
    "duration_s": 16.466667
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 36,
    "text": "Will you, won’t you, will you, won’t you, will you join the dance? Will you, won’t you, will you, won’t you, won’t you join the dance?",
    "speed": 1.0,
    "audio_description": "singing, rhythmic",
    "trailing_silence_s": 0.2,
    "start_s": 137.83265500000002,
    "end_s": 147.45877700000003,
    "duration_s": 9.626122
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 37,
    "text": "You can really have no notion how delightful it will be When they take us up and throw us, with the lobsters, out to sea!",
    "speed": 1.0,
    "audio_description": "singing, expressive",
    "trailing_silence_s": 0.2,
    "start_s": 147.45877700000003,
    "end_s": 155.56979700000002,
    "duration_s": 8.11102
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 38,
    "text": "But the snail replied “Too far, too far!” and gave a look askance— Said he thanked the whiting kindly, but he would not join the dance. Would not, could not, would not, could not, would not join the dance. Would not, could not, would not, could not, could not join the dance.",
    "speed": 1.0,
    "audio_description": "singing, melancholic",
    "trailing_silence_s": 0.2,
    "start_s": 155.56979700000002,
    "end_s": 179.61551100000003,
    "duration_s": 24.045714
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 39,
    "text": "What matters it how far we go? his scaly friend replied. There is another shore, you know, upon the other side. The further off from England the nearer is to France— Then turn not pale, beloved snail, but come and join the dance.",
    "speed": 1.0,
    "audio_description": "singing, encouraging",
    "trailing_silence_s": 0.2,
    "start_s": 179.61551100000003,
    "end_s": 193.56217800000002,
    "duration_s": 13.946667
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 40,
    "text": "Will you, won’t you, will you, won’t you, will you join the dance? Will you, won’t you, will you, won’t you, won’t you join the dance?",
    "speed": 1.0,
    "audio_description": "singing, fading",
    "trailing_silence_s": 0.5,
    "start_s": 193.56217800000002,
    "end_s": 204.52054500000003,
    "duration_s": 10.958367
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 41,
    "text": "Thank you, it’s a very interesting dance to watch, and I do so like that curious song about the whiting!",
    "speed": 1.0,
    "audio_description": "relieved, polite",
    "trailing_silence_s": 0.3,
    "start_s": 204.52054500000003,
    "end_s": 209.57523900000004,
    "duration_s": 5.054694
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 42,
    "text": "Alice felt very glad that it was over at last.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 209.57523900000004,
    "end_s": 212.06993300000005,
    "duration_s": 2.494694
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 43,
    "text": "Oh, as to the whiting, they—you’ve seen them, of course?",
    "speed": 1.0,
    "audio_description": "inquiring",
    "trailing_silence_s": 0.3,
    "start_s": 212.06993300000005,
    "end_s": 216.86340200000004,
    "duration_s": 4.793469
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 44,
    "text": "Yes, I’ve often seen them at dinn—",
    "speed": 1.0,
    "audio_description": "thoughtless",
    "trailing_silence_s": 0.1,
    "start_s": 216.86340200000004,
    "end_s": 219.03306200000003,
    "duration_s": 2.16966
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 45,
    "text": "She checked herself hastily.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.1,
    "start_s": 219.03306200000003,
    "end_s": 220.85306200000002,
    "duration_s": 1.82
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 46,
    "text": "I don’t know where Dinn may be, but if you’ve seen them so often, of course you know what they’re like.",
    "speed": 1.0,
    "audio_description": "confused, factual",
    "trailing_silence_s": 0.3,
    "start_s": 220.85306200000002,
    "end_s": 226.74367400000003,
    "duration_s": 5.890612
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 47,
    "text": "I believe so. They have their tails in their mouths—and they’re all over crumbs.",
    "speed": 1.0,
    "audio_description": "thoughtful",
    "trailing_silence_s": 0.3,
    "start_s": 226.74367400000003,
    "end_s": 231.09306200000003,
    "duration_s": 4.349388
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 48,
    "text": "You’re wrong about the crumbs: crumbs would all wash off in the sea. But they have their tails in their mouths; and the reason is—",
    "speed": 1.0,
    "audio_description": "correcting, lecture-like",
    "trailing_silence_s": 0.2,
    "start_s": 231.09306200000003,
    "end_s": 239.02122500000004,
    "duration_s": 7.928163
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 49,
    "text": "Here the Mock Turtle yawned and shut his eyes.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 239.02122500000004,
    "end_s": 241.98122500000005,
    "duration_s": 2.96
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 50,
    "text": "Tell her about the reason and all that.",
    "speed": 1.0,
    "audio_description": "bored, sleepy",
    "trailing_silence_s": 0.3,
    "start_s": 241.98122500000005,
    "end_s": 245.14789200000004,
    "duration_s": 3.166667
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 51,
    "text": "The reason is, that they would go with the lobsters to the dance. So they got thrown out to sea. So they had to fall a long way. So they got their tails fast in their mouths. So they couldn’t get them out again. That’s all.",
    "speed": 1.0,
    "audio_description": "matter-of-fact, rapid",
    "trailing_silence_s": 0.5,
    "start_s": 245.14789200000004,
    "end_s": 255.27455900000004,
    "duration_s": 10.126667
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 52,
    "text": "Thank you, it’s very interesting. I never knew so much about a whiting before.",
    "speed": 1.0,
    "audio_description": "polite",
    "trailing_silence_s": 0.3,
    "start_s": 255.27455900000004,
    "end_s": 259.59782400000006,
    "duration_s": 4.323265
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 53,
    "text": "I can tell you more than that, if you like. Do you know why it’s called a whiting?",
    "speed": 1.0,
    "audio_description": "eager",
    "trailing_silence_s": 0.3,
    "start_s": 259.59782400000006,
    "end_s": 263.50313000000006,
    "duration_s": 3.905306
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 54,
    "text": "I never thought about it. Why?",
    "speed": 1.0,
    "audio_description": "curious",
    "trailing_silence_s": 0.3,
    "start_s": 263.50313000000006,
    "end_s": 265.79707600000006,
    "duration_s": 2.293946
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 55,
    "text": "It does the boots and shoes.",
    "speed": 1.0,
    "audio_description": "solemn",
    "trailing_silence_s": 0.5,
    "start_s": 265.79707600000006,
    "end_s": 267.7170760000001,
    "duration_s": 1.92
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 56,
    "text": "Alice was thoroughly puzzled.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 267.7170760000001,
    "end_s": 269.3497290000001,
    "duration_s": 1.632653
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 57,
    "text": "Does the boots and shoes!",
    "speed": 1.0,
    "audio_description": "wondering",
    "trailing_silence_s": 0.3,
    "start_s": 269.3497290000001,
    "end_s": 270.9823820000001,
    "duration_s": 1.632653
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 58,
    "text": "Why, what are your shoes done with? I mean, what makes them so shiny?",
    "speed": 1.0,
    "audio_description": "questioning",
    "trailing_silence_s": 0.3,
    "start_s": 270.9823820000001,
    "end_s": 275.3840150000001,
    "duration_s": 4.401633
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 59,
    "text": "Alice looked down at them, and considered a little before she gave her answer.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 275.3840150000001,
    "end_s": 279.4240150000001,
    "duration_s": 4.04
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 60,
    "text": "They’re done with blacking, I believe.",
    "speed": 1.0,
    "audio_description": "uncertain",
    "trailing_silence_s": 0.3,
    "start_s": 279.4240150000001,
    "end_s": 281.6041060000001,
    "duration_s": 2.180091
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 61,
    "text": "Boots and shoes under the sea are done with a whiting. Now you know.",
    "speed": 1.0,
    "audio_description": "deep voice, authoritative",
    "trailing_silence_s": 0.3,
    "start_s": 281.6041060000001,
    "end_s": 285.7445140000001,
    "duration_s": 4.140408
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 62,
    "text": "And what are they made of?",
    "speed": 1.0,
    "audio_description": "curious",
    "trailing_silence_s": 0.3,
    "start_s": 285.7445140000001,
    "end_s": 287.3568950000001,
    "duration_s": 1.612381
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 63,
    "text": "Soles and eels, of course. Any shrimp could have told you that.",
    "speed": 1.0,
    "audio_description": "impatient",
    "trailing_silence_s": 0.5,
    "start_s": 287.3568950000001,
    "end_s": 291.40356200000014,
    "duration_s": 4.046667
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 64,
    "text": "If I’d been the whiting, I’d have said to the porpoise, ‘Keep back, please: we don’t want you with us!’",
    "speed": 1.0,
    "audio_description": "thoughtful",
    "trailing_silence_s": 0.3,
    "start_s": 291.40356200000014,
    "end_s": 296.95458200000013,
    "duration_s": 5.55102
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 65,
    "text": "Alice's thoughts were still running on the song.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 296.95458200000013,
    "end_s": 299.63458200000014,
    "duration_s": 2.68
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 66,
    "text": "They were obliged to have him with them. No wise fish would go anywhere without a porpoise.",
    "speed": 1.0,
    "audio_description": "didactic",
    "trailing_silence_s": 0.3,
    "start_s": 299.63458200000014,
    "end_s": 305.23784700000016,
    "duration_s": 5.603265
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 67,
    "text": "Wouldn’t it really?",
    "speed": 1.0,
    "audio_description": "surprised",
    "trailing_silence_s": 0.3,
    "start_s": 305.23784700000016,
    "end_s": 306.3219290000002,
    "duration_s": 1.084082
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 68,
    "text": "Of course not. Why, if a fish came to me, and told me he was going a journey, I should say ‘With what porpoise?’",
    "speed": 1.0,
    "audio_description": "certain",
    "trailing_silence_s": 0.3,
    "start_s": 306.3219290000002,
    "end_s": 312.9962150000002,
    "duration_s": 6.674286
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 69,
    "text": "Don’t you mean ‘purpose’?",
    "speed": 1.0,
    "audio_description": "correcting",
    "trailing_silence_s": 0.3,
    "start_s": 312.9962150000002,
    "end_s": 314.79798400000016,
    "duration_s": 1.801769
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 70,
    "text": "I mean what I say.",
    "speed": 1.0,
    "audio_description": "offended",
    "trailing_silence_s": 0.3,
    "start_s": 314.79798400000016,
    "end_s": 316.68465100000014,
    "duration_s": 1.886667
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 71,
    "text": "Come, let’s hear some of your adventures.",
    "speed": 1.0,
    "audio_description": "diverting",
    "trailing_silence_s": 0.3,
    "start_s": 316.68465100000014,
    "end_s": 320.45131800000013,
    "duration_s": 3.766667
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 72,
    "text": "I could tell you my adventures—beginning from this morning, but it’s no use going back to yesterday, because I was a different person then.",
    "speed": 1.0,
    "audio_description": "timid",
    "trailing_silence_s": 0.3,
    "start_s": 320.45131800000013,
    "end_s": 328.2749910000001,
    "duration_s": 7.823673
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 73,
    "text": "Explain all that.",
    "speed": 1.0,
    "audio_description": "commanding",
    "trailing_silence_s": 0.2,
    "start_s": 328.2749910000001,
    "end_s": 329.8031540000001,
    "duration_s": 1.528163
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 74,
    "text": "No, no! The adventures first, explanations take such a dreadful time.",
    "speed": 1.0,
    "audio_description": "impatient",
    "trailing_silence_s": 0.5,
    "start_s": 329.8031540000001,
    "end_s": 335.1713170000001,
    "duration_s": 5.368163
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 75,
    "text": "So Alice began telling them her adventures from the time when she first saw the White Rabbit. She was a little nervous about it just at first, the two creatures got so close to her, one on each side, and opened their eyes and mouths so very wide, but she gained courage as she went on. Her listeners were perfectly quiet till she got to the part about her repeating “You are old, Father William,” to the Caterpillar, and the words all coming different, and then the Mock Turtle drew a long breath.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 335.1713170000001,
    "end_s": 364.0313170000001,
    "duration_s": 28.86
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 76,
    "text": "That’s very curious.",
    "speed": 1.0,
    "audio_description": "impressed, slow",
    "trailing_silence_s": 0.3,
    "start_s": 364.0313170000001,
    "end_s": 365.8379840000001,
    "duration_s": 1.806667
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 77,
    "text": "It’s all about as curious as it can be.",
    "speed": 1.0,
    "audio_description": "agreeing",
    "trailing_silence_s": 0.3,
    "start_s": 365.8379840000001,
    "end_s": 368.12465100000014,
    "duration_s": 2.286667
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 78,
    "text": "It all came different! I should like to hear her try and repeat something now. Tell her to begin.",
    "speed": 1.0,
    "audio_description": "thoughtful, commanding",
    "trailing_silence_s": 0.2,
    "start_s": 368.12465100000014,
    "end_s": 374.63131800000014,
    "duration_s": 6.506667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 79,
    "text": "He looked at the Gryphon as if he thought it had some kind of authority over Alice.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 374.63131800000014,
    "end_s": 378.79784900000016,
    "duration_s": 4.166531
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 80,
    "text": "Stand up and repeat ‘Tis the voice of the sluggard.’",
    "speed": 1.0,
    "audio_description": "commanding",
    "trailing_silence_s": 0.3,
    "start_s": 378.79784900000016,
    "end_s": 382.12846100000013,
    "duration_s": 3.330612
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 81,
    "text": "How the creatures order one about, and make one repeat lessons! I might as well be at school at once.",
    "speed": 1.0,
    "audio_description": "internal thought, whispered",
    "trailing_silence_s": 0.3,
    "start_s": 382.12846100000013,
    "end_s": 387.9145830000001,
    "duration_s": 5.786122
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 82,
    "text": "However, she got up, and began to repeat it, but her head was so full of the Lobster Quadrille, that she hardly knew what she was saying, and the words came very queer indeed.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 387.9145830000001,
    "end_s": 398.4145830000001,
    "duration_s": 10.5
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 83,
    "text": "’Tis the voice of the Lobster; I heard him declare, “You have baked me too brown, I must sugar my hair.” As a duck with its eyelids, so he with his nose Trims his belt and his buttons, and turns out his toes.",
    "speed": 1.0,
    "audio_description": "reciting, confused",
    "trailing_silence_s": 0.3,
    "start_s": 398.4145830000001,
    "end_s": 410.6529500000001,
    "duration_s": 12.238367
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 84,
    "text": "When the sands are all dry, he is gay as a lark, And will talk in contemptuous tones of the Shark, But, when the tide rises and sharks are around, His voice has a timid and tremulous sound.",
    "speed": 1.0,
    "audio_description": "reciting, confused",
    "trailing_silence_s": 0.3,
    "start_s": 410.6529500000001,
    "end_s": 422.1467140000001,
    "duration_s": 11.493764
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 85,
    "text": "That’s different from what I used to say when I was a child.",
    "speed": 1.0,
    "audio_description": "confused",
    "trailing_silence_s": 0.3,
    "start_s": 422.1467140000001,
    "end_s": 425.6333810000001,
    "duration_s": 3.486667
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 86,
    "text": "Well, I never heard it before; but it sounds uncommon nonsense.",
    "speed": 1.0,
    "audio_description": "critical",
    "trailing_silence_s": 0.5,
    "start_s": 425.6333810000001,
    "end_s": 430.0872590000001,
    "duration_s": 4.453878
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 87,
    "text": "Alice said nothing; she had sat down with her face in her hands, wondering if anything would ever happen in a natural way again.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 430.0872590000001,
    "end_s": 436.6309320000001,
    "duration_s": 6.543673
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 88,
    "text": "I should like to have it explained.",
    "speed": 1.0,
    "audio_description": "demanding",
    "trailing_silence_s": 0.2,
    "start_s": 436.6309320000001,
    "end_s": 438.89759900000007,
    "duration_s": 2.266667
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 89,
    "text": "She can’t explain it. Go on with the next verse.",
    "speed": 1.0,
    "audio_description": "hasty, dismissive",
    "trailing_silence_s": 0.3,
    "start_s": 438.89759900000007,
    "end_s": 442.10426600000005,
    "duration_s": 3.206667
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 90,
    "text": "But about his toes? How could he turn them out with his nose, you know?",
    "speed": 1.0,
    "audio_description": "persisting",
    "trailing_silence_s": 0.3,
    "start_s": 442.10426600000005,
    "end_s": 446.662633,
    "duration_s": 4.558367
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 91,
    "text": "It’s the first position in dancing.",
    "speed": 1.0,
    "audio_description": "puzzled",
    "trailing_silence_s": 0.2,
    "start_s": 446.662633,
    "end_s": 448.452021,
    "duration_s": 1.789388
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 92,
    "text": "Alice was dreadfully puzzled by the whole thing, and longed to change the subject.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 448.452021,
    "end_s": 452.723041,
    "duration_s": 4.27102
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 93,
    "text": "Go on with the next verse. It begins ‘I passed by his garden.’",
    "speed": 1.0,
    "audio_description": "impatient",
    "trailing_silence_s": 0.3,
    "start_s": 452.723041,
    "end_s": 456.053653,
    "duration_s": 3.330612
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 94,
    "text": "Alice did not dare to disobey, though she felt sure it would all come wrong, and she went on in a trembling voice.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.3,
    "start_s": 456.053653,
    "end_s": 462.675694,
    "duration_s": 6.622041
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 95,
    "text": "I passed by his garden, and marked, with one eye, How the Owl and the Panther were sharing a pie—",
    "speed": 1.0,
    "audio_description": "reciting, trembling",
    "trailing_silence_s": 0.3,
    "start_s": 462.675694,
    "end_s": 469.21936700000003,
    "duration_s": 6.543673
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 96,
    "text": "The Panther took pie-crust, and gravy, and meat, While the Owl had the dish as its share of the treat. When the pie was all finished, the Owl, as a boon, Was kindly permitted to pocket the spoon: While the Panther received knife and fork with a growl, And concluded the banquet—",
    "speed": 1.0,
    "audio_description": "reciting, trembling",
    "trailing_silence_s": 0.3,
    "start_s": 469.21936700000003,
    "end_s": 484.958143,
    "duration_s": 15.738776
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 97,
    "text": "What is the use of repeating all that stuff, if you don’t explain it as you go on? It’s by far the most confusing thing I ever heard!",
    "speed": 1.0,
    "audio_description": "interrupting, frustrated",
    "trailing_silence_s": 0.3,
    "start_s": 484.958143,
    "end_s": 491.240592,
    "duration_s": 6.282449
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 98,
    "text": "Yes, I think you’d better leave off.",
    "speed": 1.0,
    "audio_description": "agreeing",
    "trailing_silence_s": 0.3,
    "start_s": 491.240592,
    "end_s": 493.727259,
    "duration_s": 2.486667
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 99,
    "text": "Alice was only too glad to do so.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.2,
    "start_s": 493.727259,
    "end_s": 495.727259,
    "duration_s": 2.0
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 100,
    "text": "Shall we try another figure of the Lobster Quadrille? Or would you like the Mock Turtle to sing you a song?",
    "speed": 1.0,
    "audio_description": "suggesting",
    "trailing_silence_s": 0.3,
    "start_s": 495.727259,
    "end_s": 501.121545,
    "duration_s": 5.394286
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 101,
    "text": "Oh, a song, please, if the Mock Turtle would be so kind.",
    "speed": 1.0,
    "audio_description": "eager",
    "trailing_silence_s": 0.3,
    "start_s": 501.121545,
    "end_s": 504.843994,
    "duration_s": 3.722449
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 102,
    "text": "Hm! No accounting for tastes! Sing her ‘Turtle Soup,’ will you, old fellow?",
    "speed": 1.0,
    "audio_description": "offended, then commanding",
    "trailing_silence_s": 0.3,
    "start_s": 504.843994,
    "end_s": 509.846443,
    "duration_s": 5.002449
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 103,
    "text": "The Mock Turtle sighed deeply, and began, in a voice sometimes choked with sobs, to sing this.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.5,
    "start_s": 509.846443,
    "end_s": 515.266443,
    "duration_s": 5.42
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 104,
    "text": "Beautiful Soup, so rich and green, Waiting in a hot tureen! Who for such dainties would not stoop? Soup of the evening, beautiful Soup! Soup of the evening, beautiful Soup!",
    "speed": 1.0,
    "audio_description": "singing, sobbing, melodramatic",
    "trailing_silence_s": 0.2,
    "start_s": 515.266443,
    "end_s": 529.13311,
    "duration_s": 13.866667
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 105,
    "text": "Beau—ootiful Soo—oop! Beau—ootiful Soo—oop! Soo—oop of the e—e—evening, Beautiful, beautiful Soup!",
    "speed": 1.0,
    "audio_description": "singing, wailing",
    "trailing_silence_s": 0.2,
    "start_s": 529.13311,
    "end_s": 535.560298,
    "duration_s": 6.427188
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 106,
    "text": "Beautiful Soup! Who cares for fish, Game, or any other dish? Who would not give all else for two p ennyworth only of beautiful Soup? Pennyworth only of beautiful Soup?",
    "speed": 1.0,
    "audio_description": "singing, passionate",
    "trailing_silence_s": 0.2,
    "start_s": 535.560298,
    "end_s": 549.078665,
    "duration_s": 13.518367
  },
  {
    "character_identifier": "MOCK_TURTLE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 107,
    "text": "Beau—ootiful Soo—oop! Beau—ootiful Soo—oop! Soo—oop of the e—e—evening, Beautiful, beauti—FUL SOUP!",
    "speed": 1.0,
    "audio_description": "singing, crescendo",
    "trailing_silence_s": 0.3,
    "start_s": 549.078665,
    "end_s": 556.432134,
    "duration_s": 7.353469
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 108,
    "text": "Chorus again!",
    "speed": 1.0,
    "audio_description": "shouting",
    "trailing_silence_s": 0.2,
    "start_s": 556.432134,
    "end_s": 557.437848,
    "duration_s": 1.005714
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 109,
    "text": "The Mock Turtle had just begun to repeat it, when a cry of “The trial’s beginning!” was heard in the distance.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.3,
    "start_s": 557.437848,
    "end_s": 563.537848,
    "duration_s": 6.1
  },
  {
    "character_identifier": "DISTANT_VOICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 110,
    "text": "The trial’s beginning!",
    "speed": 1.0,
    "audio_description": "shouting, distant",
    "trailing_silence_s": 0.3,
    "start_s": 563.537848,
    "end_s": 565.196624,
    "duration_s": 1.658776
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 111,
    "text": "Come on!",
    "speed": 1.0,
    "audio_description": "urgent",
    "trailing_silence_s": 0.2,
    "start_s": 565.196624,
    "end_s": 565.862746,
    "duration_s": 0.666122
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 112,
    "text": "Taking Alice by the hand, the Gryphon hurried off, without waiting for the end of the song.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.3,
    "start_s": 565.862746,
    "end_s": 570.60397,
    "duration_s": 4.741224
  },
  {
    "character_identifier": "ALICE",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 113,
    "text": "What trial is it?",
    "speed": 1.0,
    "audio_description": "panting, urgent",
    "trailing_silence_s": 0.2,
    "start_s": 570.60397,
    "end_s": 571.740297,
    "duration_s": 1.136327
  },
  {
    "character_identifier": "THE_GRYPHON",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 114,
    "text": "Come on!",
    "speed": 1.0,
    "audio_description": "shouting, running",
    "trailing_silence_s": 0.2,
    "start_s": 571.740297,
    "end_s": 572.4847870000001,
    "duration_s": 0.74449
  },
  {
    "character_identifier": "NARRATOR",
    "scene_identifier": "SCENE_ROCKY_LEDGE",
    "ordinal": 115,
    "text": "The Gryphon ran the faster, while more and more faintly came, carried on the breeze that followed them, the melancholy words.",
    "speed": 1.0,
    "audio_description": "narrative",
    "trailing_silence_s": 0.3,
    "start_s": 572.4847870000001,
    "end_s": 579.4647870000001,
    "duration_s": 6.98
  },
  {
