  {
    "ordinal": 3,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": true,
    "local_ordinal": 0,
    "text": "Little Room",
    "speed": 1.0,
    "audio_description": "",
    "trailing_silence_s": 1.0,
    "start_s": 6.825,
    "end_s": 8.587,
    "duration_s": 1.763265,
    "title": true,
    "part_ordinal": 0
  },
  {
    "ordinal": 4,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": true,
    "local_ordinal": 1,
    "text": "The bedroom is bathed in a warm amber light, an early and gentle hello from the night. The corners are soft and the colors are deep, but Molly is not quite ready for sleep. She pulls the warm quilt right up to her chin, waiting for all of the fun to begin.",
    "speed": 1.0,
    "audio_description": "warm, energetic but gentle rhythm",
    "trailing_silence_s": 0.5,
    "start_s": 8.587,
    "end_s": 25.017,
    "duration_s": 16.444082,
    "part_ordinal": 0
  },
  {
    "ordinal": 5,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": true,
    "local_ordinal": 2,
    "text": "She wiggles her toes at the foot of the bed. So many fun thoughts are still in her head! She wants to keep playing and stay wide awake, to see all the magic the evening will make.",
    "speed": 1.0,
    "audio_description": "playful, highlighting the wiggling toes",
    "trailing_silence_s": 0.5,
    "start_s": 25.017,
    "end_s": 35.836,
    "duration_s": 10.827755,
    "part_ordinal": 0
  },
  {
    "ordinal": 6,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": true,
    "local_ordinal": 3,
    "text": "Daddy sits down on the edge of the bed, and gently, he strokes her sleepy young head. He knows that she wants to stay up in the light, but it is time to say a soft, sweet goodnight.",
    "speed": 1.0,
    "audio_description": "calming, introducing the routine",
    "trailing_silence_s": 0.5,
    "start_s": 35.836,
    "end_s": 49.084,
    "duration_s": 13.26,
    "part_ordinal": 0
  },
  {
    "ordinal": 7,
    "segment_ordinal": 1,
    "character_identifier": "DADDY",
    "display_name": "Daddy",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": false,
    "local_ordinal": 4,
    "text": "Goodnight, wooden blocks resting quiet and still. Goodnight to the toys by the window sill.",
    "speed": 1.0,
    "audio_description": "soothing, rhythmic, leaning into the lullaby",
    "trailing_silence_s": 0.8,
    "start_s": 49.084,
    "end_s": 56.665,
    "duration_s": 7.586621,
    "part_ordinal": 0
  },
  {
    "ordinal": 8,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": true,
    "local_ordinal": 5,
    "text": "Molly looks down at the blocks on the floor. She will not be playing with them anymore. She smiles at her bear with the one floppy ear, and whispers a goodnight for him to hear.",
    "speed": 1.0,
    "audio_description": "softening tempo, warm",
    "trailing_silence_s": 0.5,
    "start_s": 56.665,
    "end_s": 66.316,
    "duration_s": 9.66,
    "part_ordinal": 0
  },
  {
    "ordinal": 9,
    "segment_ordinal": 1,
    "character_identifier": "MOLLY",
    "display_name": "Molly",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": false,
    "local_ordinal": 6,
    "text": "Goodnight, little bear, resting there on my bed. Goodnight to the pillows under my head.",
    "speed": 1.0,
    "audio_description": "sweet, slightly sleepy",
    "trailing_silence_s": 0.8,
    "start_s": 66.316,
    "end_s": 71.81,
    "duration_s": 5.498776,
    "part_ordinal": 0
  },
  {
    "ordinal": 10,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": true,
    "local_ordinal": 7,
    "text": "They look at the corner, so cozy and snug, to the wooden rocking chair by the rug. It waits by the wall in the fading glow, never moving unless it is asked to go.",
    "speed": 1.0,
    "audio_description": "steady, rocking rhythm",
    "trailing_silence_s": 0.5,
    "start_s": 71.81,
    "end_s": 82.29,
    "duration_s": 10.488163,
    "part_ordinal": 0
  },
  {
    "ordinal": 11,
    "segment_ordinal": 1,
    "character_identifier": "DADDY",
    "display_name": "Daddy",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": false,
    "local_ordinal": 8,
    "text": "Goodnight, rocking chair, waiting calm in your space. Goodnight to your gentle and quiet resting place.",
    "speed": 1.0,
    "audio_description": "hushed, peaceful",
    "trailing_silence_s": 0.8,
    "start_s": 82.29,
    "end_s": 89.637,
    "duration_s": 7.353469,
    "part_ordinal": 0
  },
  {
    "ordinal": 12,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": true,
    "local_ordinal": 9,
    "text": "Down at the foot of the bed on the rug, Cider the dog is rolled up like a bug. He watches them both with his heavy brown eyes, and lets out the softest of quiet dog sighs. His gentle breathing settles down on the floor, and he will not stay awake anymore.",
    "speed": 1.0,
    "audio_description": "slowing down, emphasizing the heavy eyes and soft breathing",
    "trailing_silence_s": 0.5,
    "start_s": 89.637,
    "end_s": 105.31,
    "duration_s": 15.686531,
    "part_ordinal": 0
  },
  {
    "ordinal": 13,
    "segment_ordinal": 1,
    "character_identifier": "MOLLY",
    "display_name": "Molly",
    "scene_identifier": "SCENE_BEDROOM_AMBER",
    "narrative": false,
    "local_ordinal": 10,
    "text": "Goodnight, little dog, resting safe on the rug. Goodnight, fuzzy Cider, my sleepy love bug.",
    "speed": 1.0,
    "audio_description": "yawny, very sleepy",
    "trailing_silence_s": 0.8,
    "start_s": 105.31,
    "end_s": 112.717,
    "duration_s": 7.412789,
    "part_ordinal": 0
  },
  {
    "ordinal": 14,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_INDIGO",
    "narrative": true,
    "local_ordinal": 11,
    "text": "The amber light fades as the evening goes deep, trading its gold for a color of sleep. A cool sleepy indigo fills up the room, where gentle shadows softly bloom. The sounds of the house become muffled and slow, a quiet and comforting rhythm to know.",
    "speed": 1.0,
    "audio_description": "slower tempo, dropping volume, hypnotic",
    "trailing_silence_s": 0.8,
    "start_s": 112.717,
    "end_s": 130.581,
    "duration_s": 17.88,
    "part_ordinal": 0
  },
  {
    "ordinal": 15,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_INDIGO",
    "narrative": true,
    "local_ordinal": 12,
    "text": "Molly looks out through the clear window glass, watching the silver starlight pass. She tries to stay up in the gentle light, but her eyes are too heavy to stay up tonight. She breathes out her worries with one little sigh, and watches the stars in the indigo sky.",
    "speed": 1.0,
    "audio_description": "drifting, peaceful surrender",
    "trailing_silence_s": 0.5,
    "start_s": 130.581,
    "end_s": 146.855,
    "duration_s": 16.287347,
    "part_ordinal": 0
  },
  {
    "ordinal": 16,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_INDIGO",
    "narrative": true,
    "local_ordinal": 13,
    "text": "Daddy leans close and points out at the sky, where a softly glowing moon is floating up high. It shines through the window, so round and so deep, to tell her that it is time to sleep.",
    "speed": 1.0,
    "audio_description": "warm, safe, concluding",
    "trailing_silence_s": 0.5,
    "start_s": 146.855,
    "end_s": 159.318,
    "duration_s": 12.473469,
    "part_ordinal": 0
  },
  {
    "ordinal": 17,
    "segment_ordinal": 1,
    "character_identifier": "DADDY",
    "display_name": "Daddy",
    "scene_identifier": "SCENE_BEDROOM_INDIGO",
    "narrative": false,
    "local_ordinal": 14,
    "text": "Goodnight, starry sky, with your gentle night breeze. Goodnight to the moon glowing over the trees.",
    "speed": 1.0,
    "audio_description": "whispered, very soft",
    "trailing_silence_s": 0.8,
    "start_s": 159.318,
    "end_s": 166.618,
    "duration_s": 7.306667,
    "part_ordinal": 0
  },
  {
    "ordinal": 18,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_INDIGO",
    "narrative": true,
    "local_ordinal": 15,
    "text": "Molly breathes in with a slow, gentle sigh, and waves to the moon floating up in the sky. The rhythm has caught her, she is ready to rest, feeling so safe in her soft little nest.",
    "speed": 1.0,
    "audio_description": "barely above a whisper, heavy with sleep",
    "trailing_silence_s": 0.5,
    "start_s": 166.618,
    "end_s": 179.916,
    "duration_s": 13.309388,
    "part_ordinal": 0
  },
  {
    "ordinal": 19,
    "segment_ordinal": 1,
    "character_identifier": "MOLLY",
    "display_name": "Molly",
    "scene_identifier": "SCENE_BEDROOM_INDIGO",
    "narrative": false,
    "local_ordinal": 16,
    "text": "Goodnight, shining moon, with your silver-white light. Goodnight, cozy bedroom, sleep tight.",
    "speed": 1.0,
    "audio_description": "drifting off, trailing away",
    "trailing_silence_s": 1.0,
    "start_s": 179.916,
    "end_s": 186.585,
    "duration_s": 6.674286,
    "part_ordinal": 0
  },
  {
    "ordinal": 20,
    "segment_ordinal": 1,
    "character_identifier": "NARRATOR",
    "display_name": "Narrator",
    "scene_identifier": "SCENE_BEDROOM_INDIGO",
    "narrative": true,
    "local_ordinal": 17,
    "text": "Her eyes softly close, and her breathing slows down, without any worry and without a frown. He watches them sleep, as the quiet room settles so cozy and deep. He whispers one final, quiet shhh in the night, leaving them safe in the moon's silver light.",
    "speed": 1.0,
    "audio_description": "final, completely hypnotic, perfectly silent at the end",
    "trailing_silence_s": 1.5,
    "start_s": 186.585,
    "end_s": 211.654,
    "duration_s": 25.090612,
    "part_ordinal": 0
  }
]