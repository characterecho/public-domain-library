  "scenes": [
    {
      "identifier": "TRAIN_COMPARTMENT",
      "ordinal": 0,
      "location_header": "INT. TRAIN COMPARTMENT - DAY",
      "visual_description": "Edwardian first-class train carriage interior. Plush red velvet seats, polished mahogany wood paneling, brass fixtures. Sunlight streaming through a window revealing passing English countryside. A folded map rests on the seat. Atmosphere of leisurely travel and solitude.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_TRAIN_COMPARTMENT.jpg"
    },
    {
      "identifier": "INT_TRAIN_CARRIAGE",
      "ordinal": 0,
      "location_header": "INT. TRAIN CARRIAGE",
      "visual_description": "Early 20th century third-class railway carriage. Wooden bench seating with high backs, brass luggage racks, and a framed map of the district on the wall. Daylight streams through the window, showing a passing rural winter landscape. Functional, slightly dusty atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_INT_TRAIN_CARRIAGE.jpg"
    },
    {
      "identifier": "VICTORIAN_STUDY",
      "ordinal": 0,
      "location_header": "INT. VICTORIAN STUDY - DAY",
      "visual_description": "A cluttered Victorian study filled with books and manuscripts. Heavy velvet curtains, a mahogany desk with a reading lamp, and leather armchairs. The atmosphere is quiet, scholarly, and slightly dusty.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_VICTORIAN_STUDY.jpg"
    },
    {
      "identifier": "SCENE_COVER_00",
      "ordinal": 0,
      "location_header": null,
      "visual_description": "A symbolic representation of the book's themes.",
      "metadata": {
        "type": "cover_placeholder"
      },
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_COVER_00.jpg"
    },
    {
      "identifier": "SCENE_SEABURGH_LANDSCAPE",
      "ordinal": 0,
      "location_header": "EXT. SEABURGH - DAY",
      "visual_description": "Victorian seaside town landscape. Marshes intersected by dykes, flat fields, heath with gorse and fir woods. A flint church with a broad western tower stands at the top of a steep road. Red brick cottages with slate roofs, white windmills on high ground. Sunny, hot atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_SEABURGH_LANDSCAPE.jpg"
    },
    {
      "identifier": "ANTIQUE_SHOP",
      "ordinal": 0,
      "location_header": "INT. ANTIQUE SHOP - DAY",
      "visual_description": "Victorian antique shop interior. Cluttered, dusty atmosphere filled with furniture, china, and curiosities. Dimly lit by daylight filtering through a shop window, highlighting dust motes. Wood textures, old varnish, shadows in corners.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_ANTIQUE_SHOP.jpg"
    },
    {
      "identifier": "VICTORIAN_LIBRARY",
      "ordinal": 0,
      "location_header": "INT. ANTIQUARY'S LIBRARY - NIGHT",
      "visual_description": "Late Victorian private library. Floor-to-ceiling dark oak bookshelves packed with leather-bound volumes. A heavy mahogany desk cluttered with papers and an oil lamp casting a warm, golden glow. Deep shadows in the corners. A comfortable leather armchair near a small fireplace. Atmosphere of scholarly solitude and antiquity.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_VICTORIAN_LIBRARY.jpg"
    },
    {
      "identifier": "CHITTENDEN_PARLOUR",
      "ordinal": 1,
      "location_header": "INT. BACK PARLOUR - DAY",
      "visual_description": "Cozy back parlour of a shop. Domestic setting with a tea table, teapot, and cups. Warmer lighting, perhaps a fireplace glow or gas lamp. Homely, slightly cramped, distinct from the showroom.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_CHITTENDEN_PARLOUR.jpg"
    },
    {
      "identifier": "BETTON_COURT_LIBRARY",
      "ordinal": 1,
      "location_header": "INT. BETTON COURT LIBRARY - DAY",
      "visual_description": "A grand, high-ceilinged library in an English country house. Tall bookshelves packed with leather-bound volumes, a large window with rain streaking the glass, and a view of wet, swaying trees outside. Gloomy afternoon light.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_BETTON_COURT_LIBRARY.jpg"
    },
    {
      "identifier": "RUSTIC_HEARTH",
      "ordinal": 1,
      "location_header": "INT. MANOR LIVING ROOM - NIGHT",
      "visual_description": "Interior of a rural English manor living room, circa 1820. A massive stone hearth with a roaring fire provides the primary light, casting dancing shadows. Heavy timber beams overhead. A high-backed armchair where a man sleeps. A rocking chair for an elderly woman. A rag rug where children sit. Warm colors: orange firelight, brown wood, cream plaster. Cozy but slightly eerie atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_RUSTIC_HEARTH.jpg"
    },
    {
      "identifier": "SCENE_HOTEL_SITTING_ROOM",
      "ordinal": 1,
      "location_header": "INT. HOTEL SITTING ROOM - NIGHT",
      "visual_description": "Private hotel sitting-room, Edwardian era. A table set for cards and writing, comfortable armchairs, dim but warm lighting from lamps. A door leading to a corridor. Quiet, private atmosphere with a sense of isolation.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_HOTEL_SITTING_ROOM.jpg"
    },
    {
      "identifier": "EXT_BROCKSTONE_VALLEY",
      "ordinal": 1,
      "location_header": "EXT. BROCKSTONE VALLEY",
      "visual_description": "A secluded, narrow valley in winter. A sudden downward path leads to groups of smokeless stone chimneys and stone-tiled roofs nestled closely together. A dense copse bounds the field, creating a sense of isolation and enclosure around the grey stone buildings.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_EXT_BROCKSTONE_VALLEY.jpg"
    },
    {
      "identifier": "COUNTRY_STATION",
      "ordinal": 1,
      "location_header": "EXT. COUNTRY STATION - AFTERNOON",
      "visual_description": "Quaint English country railway station, late afternoon. Gravel platform, white picket fences, station master's cottage with flower boxes. lush green hills in background. Sunny, peaceful, rural atmosphere. Long shadows stretching across the platform.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_COUNTRY_STATION.jpg"
    },
    {
      "identifier": "MANOR_GARDEN",
      "ordinal": 2,
      "location_header": "EXT. MANOR GARDEN - DAY",
      "visual_description": "Expansive English manor garden, midsummer. A large, ancient lime tree casting deep shade over a manicured lawn. A clear stream flows nearby. Wicker tea furniture set up on the grass. The facade of a plastered wall manor house visible in the distance. Serene and idyllic.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_MANOR_GARDEN.jpg"
    },
    {
      "identifier": "DILLET_HOUSE_EXT",
      "ordinal": 2,
      "location_header": "EXT. DILLET'S HOUSE - AFTERNOON",
      "visual_description": "Front entrance of a wealthy residence. Large wooden door, stone steps. Late afternoon light. A parked vintage car (1920s style) nearby. Sense of stability and wealth.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_DILLET_HOUSE_EXT.jpg"
    },
    {
      "identifier": "INT_BROCKSTONE_COURT",
      "ordinal": 2,
      "location_header": "INT. BROCKSTONE COURT",
      "visual_description": "Grand but abandoned interior of a 17th-century manor. Furniture is shrouded in dust sheets. High ceilings feature painted historical allegories with dark, muted tones. The atmosphere is cold, still, and preserved, smelling of old wood and neglect.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_INT_BROCKSTONE_COURT.jpg"
    },
    {
      "identifier": "BETTON_COURT_LANDSCAPE",
      "ordinal": 2,
      "location_header": "EXT. BETTON COURT GROUNDS - LATE AFTERNOON",
      "visual_description": "A wet English landscape. Dripping shrubberies of box and laurel, a stone Gothic arch in a wall, and a narrow muddy lane leading up a hill. Green and yellow fields, blue hills in the distance, and a grey, rainy sky.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_BETTON_COURT_LANDSCAPE.jpg"
    },
    {
      "identifier": "SCENE_FROSTON_CHURCH",
      "ordinal": 2,
      "location_header": "EXT. FROSTON CHURCH - DAY",
      "visual_description": "Country church exterior. A gothic porch with niches and heraldic shields. A sunny churchyard with gravestones and a path leading to the rectory. Bright daylight, peaceful rural setting.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_FROSTON_CHURCH.jpg"
    },
    {
      "identifier": "MITCHELL_COTTAGE",
      "ordinal": 3,
      "location_header": "INT. MITCHELL'S COTTAGE - DAY",
      "visual_description": "The interior of a rustic cottage. Low ceilings, simple wooden furniture, a hearth with a fire, and an old elbow-chair. Dim, warm lighting.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_MITCHELL_COTTAGE.jpg"
    },
    {
      "identifier": "HILLTOP",
      "ordinal": 3,
      "location_header": "EXT. HILLTOP - EVENING",
      "visual_description": "Top of a grassy hill at sunset. A clump of old Scotch fir trees frames the view. A sturdy wooden bench sits at the edge. Panoramic view of English plains, distant hills, and farmlands bathed in golden hour light. Atmosphere of scenic beauty and quiet observation.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_HILLTOP.jpg"
    },
    {
      "identifier": "INT_BROCKSTONE_CHAPEL",
      "ordinal": 3,
      "location_header": "INT. BROCKSTONE CHAPEL",
      "visual_description": "Interior of a 17th-century Gothic chapel. Stone walls, distinct chancel, and a western gallery with an organ case. Sunbeams illuminate dust motes dancing over blue velvet cushions on stall desks. Rich screen-work and stained glass create a solemn, hushed religious atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_INT_BROCKSTONE_CHAPEL.jpg"
    },
    {
      "identifier": "SCENE_RECTORY_STUDY",
      "ordinal": 3,
      "location_header": "INT. RECTORY STUDY - DAY",
      "visual_description": "Clergyman's study. Walls lined with books, a desk, comfortable chairs. Daytime lighting through a window. Scholarly and traditional atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_RECTORY_STUDY.jpg"
    },
    {
      "identifier": "DILLET_BEDROOM",
      "ordinal": 3,
      "location_header": "INT. DILLET'S BEDROOM - NIGHT",
      "visual_description": "Spacious, high-ceilinged bedroom. Gothic revival architectural details. Large sash windows, heavy curtains. A large kneehole table dominates the space. At night, the room is dark, illuminated only by moonlight or the spectral glow of the dollhouse.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_DILLET_BEDROOM.jpg"
    },
    {
      "identifier": "INT_HOTEL_SWAN",
      "ordinal": 4,
      "location_header": "INT. SWAN HOTEL",
      "visual_description": "Foyer and dining area of a country hotel. dark wood panelling, a heavy reception desk, and a staircase leading up. Warm, artificial lighting contrasts with the winter evening outside. Comfortable but slightly worn Victorian decor.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_INT_HOTEL_SWAN.jpg"
    },
    {
      "identifier": "SEASIDE_PROMENADE",
      "ordinal": 4,
      "location_header": "EXT. SEASIDE PROMENADE - DAY",
      "visual_description": "Coastal promenade. Bright, flat daylight. Sea wall, ocean horizon, perhaps a railing. Open air, breezy atmosphere, contrasting with the dark interiors of previous scenes.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SEASIDE_PROMENADE.jpg"
    },
    {
      "identifier": "SCENE_PAXTONS_ROOM",
      "ordinal": 4,
      "location_header": "INT. HOTEL BEDROOM - NIGHT",
      "visual_description": "Hotel bedroom. Iron bed with white counterpane, a kit-bag on a stand or chair. Electric or gas lighting. A silver crown wrapped in handkerchiefs sits on the bed. Tense, enclosed atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_PAXTONS_ROOM.jpg"
    },
    {
      "identifier": "MANOR_HALLWAY",
      "ordinal": 4,
      "location_header": "INT. MANOR HALLWAY - EVENING",
      "visual_description": "Grand entrance hall of the manor. Dark wood paneling, ticking grandfather clock, heavy oak hall table. A mysterious heavy wooden box sits on the table. Dim evening light or candlelight. mood of antiquity and slight shadow.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_MANOR_HALLWAY.jpg"
    },
    {
      "identifier": "SCENE_HOTEL_CORRIDOR",
      "ordinal": 5,
      "location_header": "INT. HOTEL CORRIDOR - NIGHT",
      "visual_description": "Hotel hallway. Rows of doors with shoes left outside. Dim lighting, shadows stretching along the walls. Eerie, silent atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_HOTEL_CORRIDOR.jpg"
    },
    {
      "identifier": "HOTEL_SMOKE_ROOM",
      "ordinal": 5,
      "location_header": "INT. HOTEL SMOKE ROOM - DAY",
      "visual_description": "Hotel smoking room. Leather armchairs, low tables, lingering haze of smoke. Club-like atmosphere, darker wood paneling, private and hushed.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_HOTEL_SMOKE_ROOM.jpg"
    },
    {
      "identifier": "INT_LONDON_OFFICE",
      "ordinal": 5,
      "location_header": "INT. LONDON OFFICE",
      "visual_description": "A dimly lit office in London. Earth-coloured distemper walls, a large fireplace, and a heavy iron safe with its door standing open. Office furniture is scattered, and a layer of strange, fine dust covers surfaces near the safe. A clinical, investigative mood.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_INT_LONDON_OFFICE.jpg"
    },
    {
      "identifier": "DREAM_GARDEN",
      "ordinal": 5,
      "location_header": "EXT. DREAM GARDEN - NIGHT",
      "visual_description": "Surreal, hazy garden setting. A rockery made of old gothic church stones and gargoyles. A dark, ominous burrow or hole beneath a shifted stone. Unsettling, nightmarish atmosphere with unnatural lighting.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_DREAM_GARDEN.jpg"
    },
    {
      "identifier": "SCENE_MOUND_NIGHT",
      "ordinal": 6,
      "location_header": "EXT. COASTAL MOUND - NIGHT",
      "visual_description": "A ridge near the coast at night. A burial mound crowned with knot of dark fir trees. Full moon illuminating the scene, casting deep shadows. Distant church tower and sea visible. Spooky, wind-swept atmosphere.",
      "metadata": {},
      "image_key": "publications/f96809709afec61636f5ee7c2146e6f9be198088/scenes/scene_SCENE_MOUND_NIGHT.jpg"
    },
    {
      "identifier": "MANOR_LIBRARY",
      "ordinal": 6,
      "location_header": "INT. MANOR LIBRARY - DAY",
