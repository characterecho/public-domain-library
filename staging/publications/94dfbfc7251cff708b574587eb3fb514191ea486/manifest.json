    {
      "ordinal": 6,
      "title": "Anxious Times",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_GARDEN_NIGHT",
            "location_header": "EXT. GARDEN BEHIND FOWL-HOUSE - NIGHT",
            "visual_description": "A moonlit garden corner behind a weathered wooden fowl-house. In the foreground, an untied sack sits among a tangle of raspberry canes and tall weeds. Deep blue shadows and cool silvery moonlight create a mysterious atmosphere. A single spot of magical light begins to glow near the ground. Earthy browns and greens in shadow."
          }
        ]
      },
      "background_key": null,
      "audio_key": "publications/94dfbfc7251cff708b574587eb3fb514191ea486/segments/6/audio.mp3",
      "duration_s": 200.51360599999995
    },
    {
      "ordinal": 7,
      "title": "The Fairy Flower",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_MAGIC_WOOD",
            "location_header": "EXT. THE WOOD - NIGHT",
            "visual_description": "A mystical clearing in the woods under bright moonlight. In the foreground, bracken fronds glisten like frosted silver against the dark earth. A central glade of smooth velvet grass is bathed in cool, blue-white lunar light, contrasting with the deep, mysterious shadows of the surrounding ancient tree trunks. The atmosphere is magical and serene, with a palette of silver, midnight blue, and charcoal gray."
          }
        ]
      },
      "background_key": null,
      "audio_key": "publications/94dfbfc7251cff708b574587eb3fb514191ea486/segments/7/audio.mp3",
      "duration_s": 103.759114
    },
