      "title": "Prologue",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_CHRISTMAS_MORNING",
            "location_header": "INT. SITTING ROOM - CHRISTMAS MORNING",
            "visual_description": "An Edwardian family sitting room on Christmas morning. Warm, diffuse winter light filters through frosted windows. In the foreground, a knitted Christmas stocking hangs from a mantelpiece, stuffed with oranges and a brown and white velveteen rabbit. In the background, a decorated Christmas tree and discarded tissue paper are visible but soft. Rich festive reds, greens, and warm wood tones."
          }
        ]
      },
      "background_key": null,
      "audio_key": "publications/94dfbfc7251cff708b574587eb3fb514191ea486/segments/1/audio.mp3",
