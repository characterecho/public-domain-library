          {
            "identifier": "SCENE_WOOD",
            "location_header": "EXT. THE WOOD - DAY",
            "visual_description": "An English woodland clearing in Spring, bathed in warm, bright sunlight. Fresh green ferns and bracken fronds frame the foreground from a low, ground-level perspective. Dappled light filters through new leaves on the trees. Soft earthy browns and vibrant fresh greens predominate."
          }
        ]
      },
