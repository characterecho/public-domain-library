      "title": "Christmas Morning",
      "metadata": {
        "scenes": [
          {
            "identifier": "SCENE_NURSERY",
            "location_header": "INT. NURSERY - DAY",
            "visual_description": "A late Victorian nursery bathed in warm afternoon light. A high metal fender guards a coal fireplace in the background. A wooden toy cupboard stands open near scuffed floorboards. In the foreground, a worn rug is scattered with toys. Soft browns, creams, and faded vintage colors."
          }
        ]
      },
